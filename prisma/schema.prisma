generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String
  type            InstitutionType @default(UNIVERSITY)
  status          TenantStatus    @default(TRIAL)
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String?
  accentColor     String?
  timezone        String          @default("Asia/Kolkata")
  locale          String          @default("en")
  country         String          @default("IN")
  address         Json?
  contactEmail    String?
  contactPhone    String?
  website         String?
  accreditationNo String?
  establishedYear Int?
  settings        Json?

  /// PRD §5.1 "Assign support manager" — the platform operator who owns this
  /// university's onboarding and support.
  ///
  /// A nullable FK to PlatformUser rather than a free-text name: the support
  /// manager is an EduOS operator, and PlatformUser is where operators live.
  /// §5.1 names the capability and defines no other field, so nothing else is
  /// modelled here.
  ///
  /// onDelete: SetNull — an operator leaving the platform must not cascade
  /// their universities away, and a dangling id would be worse than none.
  supportManagerId String?
  supportManager   PlatformUser? @relation("TenantSupportManager", fields: [supportManagerId], references: [id], onDelete: SetNull)

  /// W1.5 — when the university was archived, and by which platform operator.
  ///
  /// Kept as their own columns rather than inferred from `status`, because
  /// status can move away from ARCHIVED and the record of the archival should
  /// survive that. Null while the university has never been archived.
  archivedAt DateTime?
  archivedBy String?

  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  academicYears     AcademicYear[]
  auditLogs         AuditLog[]
  campuses          Campus[]
  certTemplates     CertificateTemplate[]
  domains           Domain[]
  idSequences       IdSequence[]
  notifications     Notification[]
  invoices          PlatformInvoice[]
  roles             Role[]
  subscriptions     Subscription[]
  users             User[]
  evaluationSchemes EvaluationScheme[]
  gradeScales       GradeScale[]
  onboardingSteps   TenantOnboardingStep[]
  /// W3 — admission applications.
  applications      Application[]
  /// PRD §7 — this university's public website pages, and the chrome around them.
  cmsPages          CmsPage[]
  cmsSite           CmsSite?

  @@index([slug])
  @@index([status])
  @@index([supportManagerId])
  passwordResetCodes PasswordResetCode[]
}

/// PRD §49.1 — the University Onboarding Workflow, verbatim and in order.
///
/// These twelve values are the PRD's own arrow-chain, not a workflow invented
/// here: "University Enquiry → Commercial Approval → Tenant Creation → Domain
/// Configuration → Branding Configuration → Module Selection → Academic Setup
/// → Data Import → User Creation → Training → UAT → Go Live".
///
/// They are what §5.1 "Track onboarding progress" tracks and what §5.1
/// "University readiness checklist" lists. No stage is added, renamed or split.
enum OnboardingStage {
  UNIVERSITY_ENQUIRY
  COMMERCIAL_APPROVAL
  TENANT_CREATION
  DOMAIN_CONFIGURATION
  BRANDING_CONFIGURATION
  MODULE_SELECTION
  ACADEMIC_SETUP
  DATA_IMPORT
  USER_CREATION
  TRAINING
  UAT
  GO_LIVE
}

/// One completed stage of one university's onboarding (PRD §5.1, §49.1).
///
/// WHY A ROW PER COMPLETED STAGE, NOT A POINTER ON Tenant
///   A single `currentStage` column can express "we are at Academic Setup" but
///   not the checklist §5.1 asks for: which stages are done, when, and by whom.
///   It also cannot represent the real case where a later stage is finished
///   before an earlier one — onboarding runs in parallel across teams, and the
///   PRD's arrow-chain is the intended order, not a lock.
///
/// The composite primary key makes a stage completable exactly once per tenant,
/// so "mark complete" is idempotent at the database rather than in a service.
///
/// This is the ONLY new model in W1.5. Every other §5.1 capability is written
/// against Tenant, Subscription, Domain, Campus, School, AcademicYear or User,
/// which already exist.
model TenantOnboardingStep {
  tenantId String
  stage    OnboardingStage

  completedAt DateTime @default(now())

  /// The PlatformUser who marked it. No FK: an operator who later leaves the
  /// platform must not take the onboarding record with them, and this column is
  /// evidence rather than a relation anything traverses.
  completedBy String?

  /// PRD §55 Stage 3 "Reconciliation" — free-text context for a stage, such as
  /// which records were reconciled. Optional and never required.
  note String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, stage])
  @@index([tenantId])
}

model Domain {
  id       String @id @default(cuid())
  tenantId String

  /// The hostname, ALWAYS stored normalised: lower-cased, no port, no trailing
  /// dot. Resolution normalises the request host the same way and compares
  /// exactly, so "AKTU.Eduos.com:3000" and "aktu.eduos.com." both find this row
  /// and nothing else does. The global unique constraint is what stops one
  /// hostname pointing at two tenants — the worst failure this table can have.
  domain String @unique

  type DomainType @default(SUBDOMAIN)

  /// Whether the institution has proven control of this hostname.
  ///
  /// An unverified domain does NOT resolve — see resolveTenantByHost. PRD §5.2
  /// asks for "Automated DNS verification" but names no mechanism, no token
  /// format and no schedule, and this stack has no worker to poll with. So the
  /// FLAG is honoured and the automation is deferred rather than guessed at;
  /// today it is set by the platform operator. The column needs no change
  /// whichever mechanism is chosen later.
  verified Boolean @default(false)

  /// A retired domain stops resolving without being deleted.
  ///
  /// Deleting is not the same thing: a removed row frees the hostname for
  /// another tenant to claim, and any link still pointing at it would then
  /// resolve to somebody else's institution.
  isActive Boolean @default(true)

  /// PRD §5.2 "Canonical domain configuration".
  ///
  /// At most one per tenant, enforced by the partial unique index below rather
  /// than by application code — two canonical domains is a state no amount of
  /// careful service logic can prevent under concurrency.
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([domain])
}

model Subscription {
  id           String             @id @default(cuid())
  tenantId     String
  plan         SubscriptionPlan   @default(STARTER)
  status       SubscriptionStatus @default(TRIAL)
  billingCycle BillingCycle       @default(MONTHLY)
  startDate    DateTime
  endDate      DateTime?
  trialEndsAt  DateTime?
  maxStudents  Int?
  maxFaculty   Int?
  maxStorage   BigInt?

  /// PRD §5.1 "Set limits for users, storage and courses".
  ///
  /// Users and storage were already representable through maxStudents,
  /// maxFaculty and maxStorage; courses had no column at all, so the third
  /// limit the PRD names could not be set. Nullable like its siblings, and
  /// nullable means "no limit" exactly as they do.
  maxCourses    Int?
  features      Json?
  pricePerMonth Decimal? @db.Decimal(10, 2)
  currency      String   @default("INR")

  /// PRD §5.3 pricing basis. Defaults to FLAT_PLAN, which is what every row
  /// created before W1.5 already was, so no stored subscription changes meaning.
  pricingModel PricingModel @default(FLAT_PLAN)

  /// PRD §5.3 "Auto-renewal management". A boolean is the whole of what the
  /// PRD defines — it names the capability and no renewal window, no notice
  /// period and no reminder schedule, so none is modelled.
  autoRenew Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  invoices  PlatformInvoice[]
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model PlatformInvoice {
  id             String        @id @default(cuid())
  tenantId       String
  subscriptionId String?
  invoiceNo      String        @unique
  amount         Decimal       @db.Decimal(10, 2)
  tax            Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  currency       String        @default("INR")
  status         InvoiceStatus @default(DRAFT)
  dueDate        DateTime?
  paidAt         DateTime?
  paymentRef     String?
  notes          String?
  lineItems      Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  tenant         Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model User {
  id           String  @id @default(cuid())
  tenantId     String
  email        String
  phone        String?
  passwordHash String
  firstName    String
  lastName     String
  displayName  String?
  avatarUrl    String?
  isActive     Boolean @default(true)
  isVerified   Boolean @default(false)

  /// W1.4 — the account holds a password it did not choose.
  ///
  /// The tenant-side counterpart of PlatformUser.mustChangePassword, and
  /// deliberately the same mechanism rather than a second one: an initial
  /// University Admin provisioned by a platform operator is in exactly the
  /// position a platform operator created by another one is — somebody else has
  /// seen the plaintext, so it is a shared secret until its owner replaces it.
  ///
  /// requireAuth refuses every tenant API while this is set, so it is a gate
  /// rather than a hint the UI may choose to honour. The single exception is
  /// POST /api/auth/change-password, which is the act that clears it.
  ///
  /// Defaults to false so every pre-W1.4 user keeps working unchanged.
  mustChangePassword Boolean @default(false)

  lastLoginAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  employee    Employee?
  faculty     FacultyMember?
  sessions    Session[]
  passwordResetCodes PasswordResetCode[]
  student     Student?
  /// W2 — back-relation for the parent portal. Emits no column on User.
  parent      Parent?
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles   UserRole[]

  // Phase 16 — back-relations for GradeScale governance attribution. Two
  // relations to the same model must be named to be unambiguous.
  gradeScalesCreated   GradeScale[] @relation("GradeScaleCreatedBy")
  gradeScalesActivated GradeScale[] @relation("GradeScaleActivatedBy")

  // Phase 16 — back-relations for EvaluationScheme governance attribution.
  evaluationSchemesCreated   EvaluationScheme[] @relation("EvaluationSchemeCreatedBy")
  evaluationSchemesActivated EvaluationScheme[] @relation("EvaluationSchemeActivatedBy")

  openElectiveOfferingsCreated OpenElectiveOffering[]

  // Phase 20 — back-relation for FeedbackForm authorship attribution.
  feedbackFormsCreated FeedbackForm[]

  // Phase 22-27 back-relations. All virtual: they emit no DDL against User and
  // change nothing Phases 1-20 rely on.
  attendanceLocksLocked          AttendanceLock[]              @relation("AttendanceLockLockedBy")
  attendanceCorrectionsRequested AttendanceCorrectionRequest[] @relation("AttendanceCorrectionRequestedBy")
  attendanceCorrectionsReviewed  AttendanceCorrectionRequest[] @relation("AttendanceCorrectionReviewedBy")
  attendanceLocksUnlocked        AttendanceLock[]              @relation("AttendanceLockUnlockedBy")

  internalAssessmentsGenerated InternalAssessmentSuggestion[] @relation("InternalAssessmentGeneratedBy")
  internalAssessmentsDecided   InternalAssessmentSuggestion[] @relation("InternalAssessmentDecidedBy")

  examResourcesUploaded ExamResource[] @relation("ExamResourceUploadedBy")
  examResourcesVerified ExamResource[] @relation("ExamResourceVerifiedBy")

  /// PRD §7 — website pages this user published, and the version snapshots
  /// they authored. Two relations rather than one because publishing a page
  /// and writing its history entry are separate acts on separate rows.
  cmsPagesPublished CmsPage[]        @relation("CmsPagePublisher")
  cmsVersions       CmsPageVersion[] @relation("CmsVersionAuthor")

  announcementsCreated Announcement[]
  announcementReads    AnnouncementRead[]

  // Phase 27 — the foreign key Notification.userId never had. See the model.
  notifications Notification[]

  /// The department this user heads, if any. Back-relation only — the column
  /// lives on Department. At most one, by the @unique on Department.hodUserId.
  headedDepartment Department? @relation("DepartmentHead")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  refreshToken String?  @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

/// A one-time code issued by the self-service password reset flow.
///
/// WHY A TABLE AND NOT A COLUMN ON USER
///   A reset is an event with its own lifetime: issued, expiring, consumed. As
///   columns on User those facts would have no history, and "was this code
///   already used" could not be answered after the next one was issued.
///
/// ONLY THE HASH IS STORED
///   `codeHash` is a bcrypt hash of the six digits, written with the same
///   helper the password column uses. A plaintext column would mean anybody who
///   could read the table could take over any account, which is the whole thing
///   a reset flow must not allow. The code exists in plaintext exactly twice:
///   in the email, and in memory for the moment it takes to hash it.
///
/// TENANT AND USER BOTH, DELIBERATELY
///   userId alone would identify the account, but every lookup in this codebase
///   is tenant-scoped and a reset must not be checkable across institutions —
///   two universities can hold the same email address.
model PasswordResetCode {
  id       String @id @default(cuid())
  tenantId String
  userId   String

  /// bcrypt hash of the six-digit code. Never the code itself.
  codeHash String

  expiresAt  DateTime
  consumedAt DateTime?

  /// Recorded for the audit trail an account takeover investigation needs.
  requestedIp String?
  userAgent   String?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The lookup the reset endpoint performs: this user's live codes, newest
  /// first.
  @@index([userId, consumedAt])
  /// Tenant-scoped cleanup and reporting.
  @@index([tenantId])
  /// Expiry sweeps.
  @@index([expiresAt])
}

model Role {
  id              String           @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id              String           @id @default(cuid())
  resource        String
  action          String
  scope           String           @default("*")
  rolePermissions RolePermission[]

  @@unique([resource, action, scope])
}

model RolePermission {
  roleId       String
  permissionId String
  grantedAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId    String
  roleId    String
  scope     Json?
  grantedAt DateTime @default(now())
  grantedBy String?
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Campus {
  id          String       @id @default(cuid())
  tenantId    String
  name        String
  code        String
  address     Json?
  phone       String?
  email       String?
  isMain      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departments Department[]
  schools     School[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model School {
  id          String       @id @default(cuid())
  tenantId    String
  campusId    String
  name        String
  code        String
  deanName    String?
  email       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
  campus      Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([campusId])
}

model Department {
  id       String  @id @default(cuid())
  tenantId String
  campusId String
  schoolId String?
  name     String
  code     String

  /// DISPLAY ONLY. The head's name as the university wishes to print it.
  ///
  /// This is NOT an authorization mechanism and must never become one: it is
  /// free text, it matches no row, and two departments may hold the same
  /// string. `hodUserId` below is the authoritative link. Kept because it is
  /// existing data that some universities may have filled in and dropping a
  /// populated column would lose it.
  hodName String?

  /// The DEPARTMENT_HOD who heads this department (MVP: exactly one).
  ///
  /// WHY A FOREIGN KEY AND NOT THE EXISTING hodName
  ///   Department-scoped authorization has to answer "which department does
  ///   this authenticated user head?" from the server, against a value the
  ///   client cannot influence. A name string cannot answer that question, and
  ///   `UserRole.scope` — the other candidate — is an untyped Json column that
  ///   nothing in the codebase reads or validates, so it would be a second
  ///   unenforced convention rather than a relation.
  ///
  /// ONE HOD → ONE DEPARTMENT, ENFORCED BY THE DATABASE
  ///   `@unique` is the whole of that rule. A user can head at most one
  ///   department, so departmentForHead() below can use findUnique and a second
  ///   assignment fails at the constraint rather than silently widening
  ///   somebody's scope. Multi-department headship is deliberately out of MVP
  ///   scope; widening later means dropping this index, not redesigning.
  ///
  /// NULLABLE, so every existing department stays valid and the migration
  /// needs no backfill. A HOD whose department is unset is refused by the
  /// scope guard rather than defaulting to "all departments" — see
  /// lib/auth/departmentScope.ts.
  ///
  /// onDelete: SetNull — an account being deleted must not take the department,
  /// its programmes and its students with it.
  hodUserId String? @unique
  hodUser   User?   @relation("DepartmentHead", fields: [hodUserId], references: [id], onDelete: SetNull)

  email      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  campus     Campus          @relation(fields: [campusId], references: [id])
  school     School?         @relation(fields: [schoolId], references: [id])
  faculty    FacultyMember[]
  programmes Programme[]

  openElectiveOfferings OpenElectiveOffering[]

  /// Phase 26 · Phase 27 back-relations. Virtual — no DDL against Department.
  examResources ExamResource[]
  announcements Announcement[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([campusId])
}

model Programme {
  id                     String                  @id @default(cuid())
  tenantId               String
  departmentId           String
  name                   String
  code                   String
  type                   ProgrammeType           @default(UNDERGRADUATE)
  durationValue          Int
  durationUnit           DurationUnit            @default(YEARS)
  totalCredits           Int?
  eligibility            String?
  description            String?
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  batches                Batch[]
  curricula              Curriculum[]
  /// W3 — back-relation for admission programme preferences. Emits no column.
  applicationPreferences ApplicationPreference[]
  department             Department              @relation(fields: [departmentId], references: [id])
  specialisations        Specialisation[]
  courseRegistrations    CourseRegistration[]

  openElectiveEligibilities OpenElectiveEligibility[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([departmentId])
}

model Specialisation {
  id          String    @id @default(cuid())
  tenantId    String
  programmeId String
  name        String
  code        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  programme   Programme @relation(fields: [programmeId], references: [id])
  students    Student[]

  openElectiveEligibilities OpenElectiveEligibility[]

  @@unique([tenantId, code])
  @@index([programmeId])
}

model AcademicYear {
  id        String     @id @default(cuid())
  tenantId  String
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean    @default(false)
  createdAt DateTime   @default(now())
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batches   Batch[]
  semesters Semester[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Semester {
  id                  String               @id @default(cuid())
  tenantId            String
  academicYearId      String
  name                String
  semesterNumber      Int
  startDate           DateTime
  endDate             DateTime
  isCurrent           Boolean              @default(false)
  createdAt           DateTime             @default(now())
  examinations        Examination[]
  feeDemands          FeeDemand[]
  sections            Section[]
  academicYear        AcademicYear         @relation(fields: [academicYearId], references: [id])
  timetables          Timetable[]
  courseRegistrations CourseRegistration[]
  assessmentEvents    AssessmentEvent[]

  openElectiveOfferings OpenElectiveOffering[]

  feedbackSubmissions FeedbackSubmission[]

  /// Phase 22 · Phase 25 · Phase 26 back-relations. Virtual — no DDL against
  /// Semester.
  attendanceLocks               AttendanceLock[]
  internalAssessmentSuggestions InternalAssessmentSuggestion[]
  examResources                 ExamResource[]

  @@unique([academicYearId, semesterNumber])
  @@index([tenantId])
}

model Batch {
  id             String       @id @default(cuid())
  tenantId       String
  programmeId    String
  academicYearId String
  name           String
  code           String
  maxStrength    Int?
  createdAt      DateTime     @default(now())
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  programme      Programme    @relation(fields: [programmeId], references: [id])
  sections       Section[]
  students       Student[]

  /// Phase 27 back-relation. Virtual — no DDL against Batch.
  announcements Announcement[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([programmeId])
}

model Section {
  id                  String               @id @default(cuid())
  tenantId            String
  batchId             String
  semesterId          String
  name                String
  maxStrength         Int?
  createdAt           DateTime             @default(now())
  attendance          Attendance[]
  batch               Batch                @relation(fields: [batchId], references: [id])
  semester            Semester             @relation(fields: [semesterId], references: [id])
  students            Student[]
  timetables          Timetable[]
  courseRegistrations CourseRegistration[]
  assessmentEvents    AssessmentEvent[]

  /// Phase 22 · Phase 27 back-relations. Virtual — no DDL against Section.
  attendanceLocks AttendanceLock[]
  announcements   Announcement[]

  @@unique([batchId, semesterId, name])
  @@index([tenantId])
}

model Curriculum {
  id            String              @id @default(cuid())
  tenantId      String
  programmeId   String
  name          String
  version       String
  effectiveFrom DateTime
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  programme     Programme           @relation(fields: [programmeId], references: [id])
  subjects      CurriculumSubject[]

  @@unique([programmeId, version])
  @@index([tenantId])
}

model CurriculumSubject {
  id             String     @id @default(cuid())
  curriculumId   String
  courseId       String
  semesterNumber Int
  isCompulsory   Boolean    @default(true)
  credits        Int
  internalMarks  Int?
  externalMarks  Int?
  createdAt      DateTime   @default(now())
  course         Course     @relation(fields: [courseId], references: [id])
  curriculum     Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)

  @@unique([curriculumId, courseId, semesterNumber])
}

model Course {
  id                  String                    @id @default(cuid())
  tenantId            String
  departmentId        String?
  name                String
  code                String
  type                CourseType                @default(CORE)
  credits             Int                       @default(3)
  description         String?
  syllabus            String?
  isActive            Boolean                   @default(true)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  assignments         Assignment[]
  curriculumSubjects  CurriculumSubject[]
  examinations        Examination[]
  facultyAssignments  FacultyCourseAssignment[]
  timetables          Timetable[]
  courseRegistrations CourseRegistration[]
  assessmentEvents    AssessmentEvent[]

  openElectiveOfferings OpenElectiveOffering[]

  feedbackSubmissions FeedbackSubmission[]

  /// Phase 22 · Phase 25 · Phase 26 back-relations. Virtual in Prisma — they
  /// emit no DDL against this table and leave every existing column, index and
  /// constraint on Course exactly as Phases 1-20 left them.
  attendanceLocks               AttendanceLock[]
  internalAssessmentSuggestions InternalAssessmentSuggestion[]
  examResources                 ExamResource[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([departmentId])
}

model Student {
  id                  String                 @id @default(cuid())
  tenantId            String
  userId              String                 @unique
  enrollmentNo        String
  programmeId         String?
  batchId             String?
  sectionId           String?
  specialisationId    String?
  currentSemester     Int                    @default(1)
  status              StudentStatus          @default(ACTIVE)
  admissionDate       DateTime
  graduationDate      DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  submissions         AssignmentSubmission[]
  attendance          Attendance[]
  certificates        Certificate[]
  hallTickets         HallTicket[]
  examResults         ExamResult[]
  feeDemands          FeeDemand[]
  payments            Payment[]
  batch               Batch?                 @relation(fields: [batchId], references: [id])
  section             Section?               @relation(fields: [sectionId], references: [id])
  specialisation      Specialisation?        @relation(fields: [specialisationId], references: [id])
  user                User                   @relation(fields: [userId], references: [id])
  documents           StudentDocument[]
  parents             StudentParent[]
  personal            StudentPersonal?
  courseRegistrations CourseRegistration[]
  achievements        Achievement[]
  /// W3 — the application this student was converted from, if any.
  application         Application?

  openElectivePreferences OpenElectivePreference[]
  openElectiveAllocations OpenElectiveAllocation[]

  feedbackSubmissions FeedbackSubmission[]

  /// Phase 25 back-relation. Virtual — no DDL against Student.
  internalAssessmentSuggestions InternalAssessmentSuggestion[]

  @@unique([tenantId, enrollmentNo])
  @@index([tenantId])
  @@index([batchId])
  @@index([sectionId])
}

