/// Lifecycle of an EvaluationScheme revision.
///
/// Deliberately a SEPARATE enum from GradeScaleStatus despite sharing values
/// today. The two aggregates version independently, and a regulation is the one
/// likely to gain a state a grading vocabulary never needs — a
/// PENDING_APPROVAL step for Controller-of-Examination sign-off. Sharing one
/// enum would force that state onto GradeScale as well.
enum EvaluationSchemeStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// How a course sat more than once is reconciled when CGPA is computed.
///
/// BEST_ATTEMPT  — the highest grade point counts; the rest are history.
/// LATEST_ATTEMPT— the most recent attempt supersedes all earlier ones.
/// FIRST_ATTEMPT — the original attempt stands; re-sits clear a backlog but do
///                 not improve the grade.
/// ALL_ATTEMPTS  — every attempt enters the average, including failures.
enum AttemptPolicy {
  BEST_ATTEMPT
  LATEST_ATTEMPT
  FIRST_ATTEMPT
  ALL_ATTEMPTS
}

/// Rounding applied to a computed figure, named after the IEEE 754 / Java
/// BigDecimal vocabulary so the intent is unambiguous to any implementer.
///
/// HALF_UP   — 2.5 -> 3, -2.5 -> -3. The common institutional default.
/// HALF_DOWN — 2.5 -> 2.
/// HALF_EVEN — 2.5 -> 2, 3.5 -> 4. Banker's rounding; removes the systematic
///             upward bias HALF_UP introduces across a large cohort.
/// FLOOR     — always toward negative infinity.
/// CEILING   — always toward positive infinity.
enum RoundingMode {
  HALF_UP
  HALF_DOWN
  HALF_EVEN
  FLOOR
  CEILING
}

enum EvaluationComponentType {
  THEORY
  PRACTICAL
  VIVA
  LAB
  ASSIGNMENT
  QUIZ
  ATTENDANCE
  PROJECT
  SEMINAR
  PRESENTATION
  INTERNAL
  EXTERNAL
  CUSTOM
}

/// How ONE leaf component's repeated sessions reduce to a single figure.
///
/// SUM            — every session adds up; the scale is the total of them.
/// AVERAGE        — the mean of every session sat.
/// BEST_N         — the highest N sessions count; ruleConfig.count supplies N.
/// DROP_LOWEST_N  — the lowest N are discarded; ruleConfig.count supplies N.
/// MAX            — the single highest session.
/// LATEST         — the most recent session supersedes the rest.
///
/// Replaces the superseded EvaluationRuleType, which mixed these session-level
/// operators with the child-level ones now in ComponentRollup.
enum ComponentAggregation {
  SUM
  AVERAGE
  BEST_N
  DROP_LOWEST_N
  MAX
  LATEST
}

/// How a BRANCH component's children reduce to its own figure.
///
/// WEIGHTED_SUM — each child contributes its weightage percent. The ordinary
///                case, and the only one whose siblings must total 100.
/// SUM          — children add up on their raw scales, weightage ignored.
/// AVERAGE      — the unweighted mean of the children.
enum ComponentRollup {
  WEIGHTED_SUM
  SUM
  AVERAGE
}

/// What a recorded mark means.
///
/// RECORDED  — the student sat and was marked. marksObtained is present.
/// ABSENT    — the student did not sit. marksObtained is NULL, which is
///             different from a mark of zero: a mandatory component treats the
///             two differently, and a transcript shows them differently.
/// WITHHELD  — a mark exists but must not be used or shown, pending a
///             disciplinary or financial hold. marksObtained is present, since
///             a student who did not sit is ABSENT rather than withheld.
///
/// The invariant, enforced by the service because no column-level constraint
/// can express it: marksObtained is NULL exactly when the status is ABSENT.
enum MarkStatus {
  RECORDED
  ABSENT
  WITHHELD
}

/// The lifecycle of one assessment sitting.
///
/// DRAFT     — scheduled, but mark entry is not yet open. An assessment
///             calendar is built before any paper is marked, and a sitting in
///             this state accepts nothing.
/// OPEN      — mark entry is permitted. This is the ONLY state in which a mark
///             may be created or amended; that single rule is what locking
///             means.
/// LOCKED    — marks are frozen and verified, but not yet visible to students.
///             The verification gate: a sitting cannot go straight from OPEN to
///             PUBLISHED, so nothing reaches a student without someone having
///             closed entry first.
/// PUBLISHED — marks are visible to students.
///
/// Two transitions run BACKWARDS, deliberately. LOCKED -> OPEN reopens entry to
/// correct an error, and PUBLISHED -> LOCKED is the unpublish the workflow
/// requires. Both are audited like any other change. A lifecycle with no
/// correction path is the defect recorded as TD-C40, where an accidental
/// revocation could only be undone through direct database access.
enum AssessmentEventStatus {
  DRAFT
  OPEN
  LOCKED
  PUBLISHED
}

/// Why a course enrolment exists.
///
/// REGULAR         — the ordinary first sitting, within the student's own
///                   programme.
/// ELECTIVE        — chosen from the programme's own elective basket.
/// OPEN_ELECTIVE   — chosen from another department's offering. Distinct from
///                   ELECTIVE because degree audit counts the two against
///                   different requirement buckets.
/// AUDIT           — attended without credit. Carries no weight in SGPA, which
///                   the engine derives from this member rather than from a
///                   separate flag.
/// BACKLOG         — a re-sit after the previous attempt FAILED on marks.
/// IMPROVEMENT     — a re-sit after the previous attempt PASSED, to better the
///                   grade. Reconciled under the scheme's attemptPolicy.
/// REPEAT          — the course is taken again from scratch because the
///                   previous attempt could not be completed — detained,
///                   debarred or withdrawn. Distinct from BACKLOG because the
///                   earlier attempt produced no mark to improve on, and a
///                   transcript treats the two differently.
/// CREDIT_TRANSFER — credit recognised from another institution. Carries
///                   credits but expects no marks, so the calculation engine
///                   skips it rather than reporting it as unmarked.
///
/// There is deliberately no SUMMER member: a summer term is a property of the
/// Semester row, not of the enrolment, and encoding it here would be a second
/// place to ask when a course was taken.
enum RegistrationType {
  REGULAR
  ELECTIVE
  OPEN_ELECTIVE
  AUDIT
  BACKLOG
  IMPROVEMENT
  REPEAT
  CREDIT_TRANSFER
}

/// The lifecycle of an academic enrolment.
///
/// REGISTERED — provisionally enrolled, within the add/drop window.
/// CONFIRMED  — enrolment finalised; the student now counts toward assessment
///              and appears on every roster.
/// DROPPED    — left during add/drop. Leaves NO transcript record.
/// WITHDRAWN  — left after confirmation. DOES appear on the transcript, which
///              is precisely why it is a separate state from DROPPED rather
///              than a nuance of one.
/// COMPLETED  — the contract is discharged and a published result exists.
/// CANCELLED  — the registration was an administrative error. Retained rather
///              than deleted, so the correction itself stays auditable.
///
/// REGISTERED and CONFIRMED are the ACTIVE states; the other four are terminal.
/// A registration is never physically deleted — destroying one would destroy
/// the historical roster this model exists to preserve.
enum RegistrationStatus {
  REGISTERED
  CONFIRMED
  DROPPED
  WITHDRAWN
  COMPLETED
  CANCELLED
}

/// What a passing criterion measures, and therefore when it is evaluated.
///
/// COMPONENT_SCORE         — one component's computed value. Course-scoped;
///                           requires componentId. This is "Theory Pass",
///                           "Internal Pass", "Practical Pass" — any of them,
///                           with no per-component enum value, because the
///                           component is named by a foreign key rather than by
///                           a hard-coded vocabulary.
/// ATTENDANCE_PERCENT      — attendance in the course. Course-scoped.
/// SEMESTER_CREDITS_EARNED — credits earned across the semester.
///                           SEMESTER-scoped: evaluated once per student per
///                           semester against their governing regulation, not
///                           once per course.
///
/// There is deliberately NO COURSE_TOTAL member. The overall pass mark is
/// already the boundary of the lowest passing GradeBand, and declaring it twice
/// would create two authorities for one question — the exact duplication this
/// schema forbids. See the note on PassingCriterion.
enum PassingMetric {
  COMPONENT_SCORE
  ATTENDANCE_PERCENT
  SEMESTER_CREDITS_EARNED
}

/// How a criterion's threshold should be read.
///
/// MARKS   — an absolute figure on the component's own scale, "21 out of 70".
/// PERCENT — a proportion, "30% of the component" or "75% attendance".
/// CREDITS — a credit count, for SEMESTER_CREDITS_EARNED.
enum ThresholdUnit {
  MARKS
  PERCENT
  CREDITS
}

/// The consequence of missing a threshold.
///
/// FAIL       — the requirement was not met. The student carries a backlog and
///              may clear it by re-sitting.
/// INELIGIBLE — the student was barred from the assessment, or from
///              progressing. Not a mark-based failure and not clearable by
///              re-sitting the same attempt.
///
/// Two values because the downstream consequence genuinely differs; no third
/// value for promotion, because at semester scope INELIGIBLE already reads as
/// "not eligible to progress".
enum CriterionOutcome {
  FAIL
  INELIGIBLE
}

/// The stage of the calculation pipeline a rule runs at.
///
/// The pipeline is: raw sessions → [SESSION_ADJUSTMENT] → component
/// aggregation (owned by EvaluationComponent) → [COMPONENT_ADJUSTMENT] →
/// weighted rollup up the tree → course total → [COURSE_ADJUSTMENT] → grade
/// assignment (owned by GradeScale).
///
/// SESSION_ADJUSTMENT   — transforms each raw session mark BEFORE the component
///                        aggregates them. "Two bonus marks on every quiz."
/// COMPONENT_ADJUSTMENT — transforms one component's aggregated figure.
///                        "Normalise the 20-mark internal onto 30."
/// COURSE_ADJUSTMENT    — transforms the course total after everything has
///                        rolled up. Grace, moderation and curving live here.
///
/// A new phase is a new pipeline stage, which needs engine code regardless, so
/// nothing is lost by making this an enum — and a great deal is gained, since
/// the engine dispatches on it and an unconstrained string would let a typo
/// silently disable a rule.
enum RulePhase {
  SESSION_ADJUSTMENT
  COMPONENT_ADJUSTMENT
  COURSE_ADJUSTMENT
}

/// What a rule does to the value flowing through its stage.
///
/// Every operation is a pure numeric transform: it takes the incoming value
/// (and, for cohort operations, the cohort's distribution) and returns one
/// number. None of them reads a pass threshold, assigns a grade, or alters the
/// component tree.
///
/// ADD_CONSTANT   — value + amount. Fixed bonus marks.
/// ADD_PERCENTAGE — value + value × percent/100. Proportional bonus.
/// SCALE          — value × factor. Normalising a component onto another scale.
/// CAP            — min(value, limit). The guard that stops a bonus exceeding
///                  the maximum; always the last rule in a stage.
/// FLOOR          — max(value, limit).
/// GRACE          — a conditional top-up of at most config.maxAward. The one
///                  operation that consults a threshold, and it does not own
///                  that threshold: PassingCriteria supplies it and the engine
///                  passes it in.
/// MODERATION     — shifts the cohort onto a target mean and spread.
/// CURVE          — redistributes the cohort onto a target distribution.
/// CUSTOM_FORMULA — evaluates a restricted, whitelisted expression tree. This
///                  is the escape hatch that makes "no redesign for a future
///                  rule" true: arithmetic nobody anticipated is a config
///                  value, not a migration.
///
/// MODERATION and CURVE are COHORT-SCOPED — they cannot be computed for one
/// student in isolation. That is derivable from the operation itself, so no
/// column records it; storing a flag would be a second source of truth for a
/// fact this enum already determines.
enum RuleOperation {
  ADD_CONSTANT
  ADD_PERCENTAGE
  SCALE
  CAP
  FLOOR
  GRACE
  MODERATION
  CURVE
  CUSTOM_FORMULA
}

/// Where a component's marks originate.
///
/// MANUAL_ENTRY       — typed in by faculty against an assessment session.
/// ATTENDANCE_DERIVED — computed from the student's attendance percentage via
///                      ruleConfig.attendanceBands. This is what makes
///                      "Attendance Marks" configuration rather than code.
/// ASSIGNMENT_DERIVED — pulled from the existing assignment submissions.
/// COMPUTED           — produced by the engine from other components; carries
///                      no marks of its own.
enum ComponentSource {
  MANUAL_ENTRY
  ATTENDANCE_DERIVED
  ASSIGNMENT_DERIVED
  COMPUTED
}

/// Lifecycle of a GradeScale revision.
///
/// DRAFT    — under construction, freely editable, never used by any
///            calculation. Bands may be incomplete; the tiling rule is checked
///            at activation, not on every insert, so a scale can be built up
///            one band at a time.
/// ACTIVE   — frozen and in use. Exactly one revision per (tenantId, code) may
///            hold this state; that single-active rule is enforced by the
///            activation transaction in the service layer, since PostgreSQL
///            cannot express it without a partial unique index that Prisma
///            would not track.
/// ARCHIVED — frozen and retired. Still readable forever, because results
///            already computed against it must remain reproducible.
enum GradeScaleStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum GradeCalculationMethod {
  ABSOLUTE
  RELATIVE
}

enum ResultPublicationStatus {
  DRAFT
  VERIFIED
  APPROVED
  PUBLISHED
}

enum TranscriptStatus {
  GENERATED
  VERIFIED
  ISSUED
}

/// Phase 20 — Faculty Feedback System.
///
/// A versioned, tenant-owned QUESTIONNAIRE: the set of questions a student is
/// asked about one faculty member in one course.
///
/// NO FIXED RATING COLUMNS. "Teaching", "Behaviour", "Communication",
/// "Practical Knowledge" and "Infrastructure" are not columns anywhere in this
/// section — they are FeedbackCategory values a tenant writes its own questions
/// against. A university adding a ninth dimension configures a row rather than
/// requesting a migration, which is the entire point of the model.
///
/// OWNERSHIP    : Tenant, carried as a plain column. Unlike GradeScale, there
///                is no Tenant relation: a form is configuration, not a
///                governed regulation, and the FK would only add a cascade the
///                repository's tenant predicate already covers.
/// LIFECYCLE    : DRAFT -> OPEN -> CLOSED. Questions are editable only while
///                DRAFT; OPEN is the only state in which a submission may be
///                written; CLOSED freezes the cohort so a report is
///                reproducible.
/// VERSIONING   : (tenantId, code) names the form; `version` names the
///                revision. A submission pins one revision, so a report can
///                always state which questions were actually asked.
model FeedbackForm {
  id       String @id @default(cuid())
  tenantId String

  /// Stable identifier ACROSS versions, e.g. "LEC-FEEDBACK". Two rows sharing
  /// a code are two revisions of one questionnaire.
  code String

  name        String
  description String?

  /// Revision number within (tenantId, code), starting at 1. Never reused.
  version Int @default(1)

  status FeedbackFormStatus @default(DRAFT)

  /// Which kind of session this form is asked about. Reuses the existing
  /// SessionType rather than declaring a parallel enum: a lab feedback form and
  /// a lecture feedback form differ in the sessions they apply to, and that
  /// vocabulary already exists on Timetable and Attendance.
  sessionType SessionType @default(LECTURE)

  createdById String?

  /// When the status last changed. ONE column rather than a nullable timestamp
  /// per state, matching CourseRegistration and AssessmentEvent: AuditLog
  /// already holds every transition with its actor.
  statusChangedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// SetNull because DELETE /api/users/[id] is a hard delete that a Restrict
  /// here would begin rejecting. The permanent, actor-preserving record is
  /// AuditLog.
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  questions   FeedbackQuestion[]
  submissions FeedbackSubmission[]

  /// One revision number per named form per tenant.
  @@unique([tenantId, code, version])
  /// Not a uniqueness rule — `id` is already unique. This is the TARGET of the
  /// composite foreign keys on FeedbackQuestion and FeedbackSubmission, which
  /// is what makes a cross-tenant child structurally impossible rather than
  /// merely avoided.
  @@unique([tenantId, id])
  /// The catalogue read: which forms are open, for this kind of session, in
  /// this tenant.
  @@index([tenantId, status, sessionType])
}

/// Phase 20 — one question on a form.
///
/// This model IS the "no fixed rating columns" requirement. The question text
/// is the tenant's, and `category` places it in a broad, institution-neutral
/// grouping that a report rolls up by.
///
/// OWNERSHIP    : FeedbackForm. A question has no lifecycle of its own and is
///                deleted with its form.
/// LIFECYCLE    : Mutable only while the owning form is DRAFT.
model FeedbackQuestion {
  id String @id @default(cuid())

  /// Carried so the composite foreign key below can prove this question and its
  /// form belong to the same tenant. Constrained by that key to equal the
  /// form's tenantId, so the two cannot diverge.
  tenantId String
  formId   String

  /// Stable handle within the form — "Q1", "CLARITY". A report years later must
  /// name which question a score came from, and a cuid explains nothing.
  code String

  text String

  category FeedbackCategory

  /// How much this question counts in its category's average. Decimal(5,2)
  /// matching the weightage columns of Phase 16, and exact base-10 so a
  /// weighted mean has no binary rounding error. Defaults to 1.00, which is the
  /// unweighted case every tenant starts from.
  weight Decimal @default(1.00) @db.Decimal(5, 2)

  /// Presentation order within the form.
  sequence Int

  /// Whether an answer is required for the submission to be completable. The
  /// service branches on it, so it is a column.
  isRequired Boolean @default(true)

  /// Whether a free-text comment may accompany the rating. A question may be
  /// rating-only; this is what says so.
  allowsComment Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Owning form, tenant-proving. Cascade because a question cannot outlive its
  /// form.
  form FeedbackForm @relation(fields: [tenantId, formId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  answers FeedbackAnswer[]

  /// One handle per form. Both columns are NOT NULL, so PostgreSQL enforces
  /// this completely.
  @@unique([formId, code])
  /// THE hot read: one form's questions, in order.
  @@index([tenantId, formId, sequence])
}

/// Phase 20 — one student's feedback on one faculty member, for one course, in
/// one semester, against one form.
///
/// ANONYMITY IS A PROJECTION, NOT A COLUMN.
///   studentId is stored, because a duplicate submission cannot otherwise be
///   refused and an audit cannot otherwise be answered. What keeps it away from
///   faculty is the repository publishing two projections and no third —
///   ANONYMOUS_SUBMISSION_SELECT omits the column entirely, so a faculty-facing
///   query physically cannot return an identity. There is no masking step to
///   forget.
///
/// LIFECYCLE    : DRAFT -> SUBMITTED. A DRAFT is a student mid-thought and is
///                never read by an analytic; only SUBMITTED rows are averaged.
model FeedbackSubmission {
  id       String @id @default(cuid())
  tenantId String

  formId String

  studentId String

  /// Who the feedback is ABOUT.
  facultyId String

  /// The course and term it concerns. Both required: feedback about a faculty
  /// member detached from what and when they taught cannot be reported on.
  courseId   String
  semesterId String

  status FeedbackSubmissionStatus @default(DRAFT)

  /// When the student finalised it. NULL exactly while the status is DRAFT.
  submittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Owning form, tenant-proving. Cascade because a submission against a
  /// deleted form has no questions to interpret it.
  form FeedbackForm @relation(fields: [tenantId, formId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  /// Plain single-column keys: none of these pre-existing parents carries
  /// @@unique([tenantId, id]), and adding one would mean a blocking index build
  /// on a live, populated table. Cross-tenant consistency here is enforced by
  /// the repository, which filters every query on tenantId — a stated
  /// weakening, not an oversight.
  ///
  /// Cascade on Student, matching StudentDocument and OpenElectivePreference: a
  /// removed student's feedback has no author. NoAction on the other three,
  /// checked at end-of-statement, so a stray delete that would orphan a
  /// submission is refused while a tenant-level cascade still succeeds.
  student  Student       @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  faculty  FacultyMember @relation(fields: [facultyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course   Course        @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  semester Semester      @relation(fields: [semesterId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  answers FeedbackAnswer[]

  /// One submission per student, per faculty member, per course, per term, per
  /// form. This constraint — not a prior read — is what actually prevents a
  /// duplicate: two concurrent submits both see nothing and both proceed. Every
  /// column is NOT NULL, so PostgreSQL enforces it completely.
  @@unique([studentId, facultyId, courseId, semesterId, formId])
  /// Composite-FK target for FeedbackAnswer.
  @@unique([tenantId, id])
  /// THE faculty report, exactly: every submission about one faculty member for
  /// one course in one term, filtered to SUBMITTED.
  @@index([tenantId, facultyId, courseId, semesterId, status])
  /// The per-form read: response counts and completion for one questionnaire.
  @@index([tenantId, formId, status])
  /// Supports the cascade on student deletion. PostgreSQL does not index a
  /// foreign key automatically.
  @@index([studentId])
}

/// Phase 20 — one student's answer to one question.
///
/// OWNERSHIP    : FeedbackSubmission. An answer has no meaning without the
///                submission it belongs to and is deleted with it.
/// LIFECYCLE    : Replaced wholesale rather than diffed — the repository
///                deletes and re-inserts inside one transaction, because the
///                (submissionId, questionId) constraint makes a partial update
///                a minefield.
model FeedbackAnswer {
  id String @id @default(cuid())

  /// Carried so the composite foreign key below can prove this answer and its
  /// submission belong to the same tenant, and so a cohort's answers can be
  /// read tenant-scoped in ONE statement without a join.
  tenantId     String
  submissionId String

  questionId String

  /// The rating, an integer on the 1..5 scale. SmallInt rather than Int because
  /// this is the largest table in the phase — students × faculty × courses ×
  /// questions — and the range is bounded by two orders of magnitude more than
  /// it will ever need. The bounds themselves are enforced by Zod at the
  /// service boundary, where a violation can be reported to the student.
  rating Int @db.SmallInt

  /// Free text, permitted only when the question sets allowsComment.
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Owning submission, tenant-proving. Cascade because an answer cannot
  /// outlive its submission.
  submission FeedbackSubmission @relation(fields: [tenantId, submissionId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  /// The question answered. Cascade because an answer to a deleted question
  /// cannot be interpreted, and questions are only deletable while the form is
  /// DRAFT — a state in which no submission exists.
  question FeedbackQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// A student cannot answer one question twice. Both columns are NOT NULL, so
  /// PostgreSQL enforces this completely.
  @@unique([submissionId, questionId])
  /// One submission's answers, and the cohort read that aggregates a report
  /// without an N+1.
  @@index([tenantId, submissionId])
  /// Supports the cascade on question deletion.
  @@index([questionId])
}

/// Lifecycle of a feedback form revision.
///
/// DRAFT  — being written. Invisible to students; questions may still change.
/// OPEN   — students may submit and edit. The ONLY state in which a submission
///          may be written.
/// CLOSED — submissions frozen. The cohort is fixed, which is what makes a
///          report reproducible.
///
/// Deliberately a SEPARATE enum from OpenElectiveStatus and
/// EvaluationSchemeStatus despite the shared shape: the three aggregates
/// version independently, and a form is the one likely to gain a state the
/// others never need.
enum FeedbackFormStatus {
  DRAFT
  OPEN
  CLOSED
}

/// The broad dimension a question measures.
///
/// This enum is what replaces fixed rating columns. It is institution-neutral
/// on purpose — nothing here names a department, a course or a teaching style —
/// because these must mean the same thing to every tenant for a cross-faculty
/// report to be comparable. A tenant needing finer granularity writes more
/// QUESTIONS in a category, which is a row, not a migration. OVERALL carries
/// the summary question every form ends on.
enum FeedbackCategory {
  TEACHING
  BEHAVIOUR
  COMMUNICATION
  PRACTICAL_KNOWLEDGE
  INFRASTRUCTURE
  LAB_EXPERIENCE
  OVERALL
}

/// Lifecycle of one student's submission.
///
/// DRAFT     — saved but not finalised. A student mid-thought. NEVER read by an
///             analytic: averaging a half-finished form would let it move a
///             faculty member's score when the student never said it was done.
/// SUBMITTED — finalised. The only status any statistic reads.
///
/// There is deliberately no WITHDRAWN member: a student who changes their mind
/// while the form is OPEN edits their answers, and once the form is CLOSED the
/// cohort is fixed by design.
enum FeedbackSubmissionStatus {
  DRAFT
  SUBMITTED
}

// ============================================================================
// PHASES 21-27 — Student Permissions, Attendance Lock, Faculty Analytics,
//                Assignment Enhancement, AI Internal Assessment, Exam Resource
//                Repository, Notification Center & Announcements.
//
// PHASE 21 DECLARES NO MODEL AND THAT IS THE DESIGN.
//   The student permission matrix is a FIXED, README-derived constant living in
//   lib/constants/studentPermissions.ts, not a table. Nothing in the README
//   describes a university editing it, and a stored matrix would be a second
//   source of truth able to drift from the route guards that actually enforce
//   access — the enforcement is requireRole plus ownership checks, and this
//   endpoint only DESCRIBES it.
// ============================================================================

/// Phase 22 — whether a lock is currently in force.
///
/// Two members, not three. An "unlocked" row is a lock that WAS taken and has
/// since been released; the absence of a row is the never-locked case. Keeping
/// the released row is what gives the audit endpoint its history, and what lets
/// lockedBy and unlockedBy both stay attributable on one record.
enum AttendanceLockStatus {
  LOCKED
  UNLOCKED
}

/// PRD 13.2 — "Attendance correction requests", "Faculty approval",
/// "Academic admin approval".
///
/// WHY A REQUEST EXISTS AT ALL, RATHER THAN AN EDIT
///   Attendance has no PATCH handler and no updatedAt column: markedAt and
///   markedBy describe the ORIGINAL mark, so an in-place edit would silently
///   rewrite who recorded what and when. A request records the change as its own
///   fact — who asked, what it was, what they want, why — so the register's
///   history survives the correction instead of being overwritten by it.
///
/// WHY currentStatus IS COPIED HERE
///   It is the value AS SEEN when the request was raised. Reading it from the
///   Attendance row at approval time would show whatever it is by then, which is
///   exactly the information an approver needs to not have moved under them. It
///   also lets a rejected request still explain what was being disputed.
///
/// ONE PENDING REQUEST PER RECORD
///   Enforced by a PARTIAL unique index created in the migration —
///   `WHERE status = 'PENDING'` — which Prisma's schema language cannot express.
///   A plain @@unique on attendanceId would forbid a second correction after the
///   first was decided, which is wrong: a register may be corrected twice.
enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

model AttendanceCorrectionRequest {
  id       String @id @default(cuid())
  tenantId String

  attendanceId String

  /// The status the record carried when the request was raised.
  currentStatus   AttendanceStatus
  /// The status the requester is asking for.
  requestedStatus AttendanceStatus

  /// Required. A correction with no stated reason is not reviewable.
  reason String

  status AttendanceCorrectionStatus @default(PENDING)

  requestedById String?
  requestedAt   DateTime @default(now())

  reviewedById String?
  reviewedAt   DateTime?
  /// Why it was rejected, or a note on approval. Required on rejection by the
  /// service — the person whose correction was refused is owed the reason.
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Cascade: a correction request for a record that no longer exists describes
  /// nothing. The audit trail carries the history that must outlive the row.
  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  requestedBy User? @relation("AttendanceCorrectionRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reviewedBy  User? @relation("AttendanceCorrectionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([tenantId, status])
  @@index([attendanceId])
  @@index([requestedById])
}

/// Phase 22 — a finalisation over one teaching unit's attendance.
///
/// THE SCOPE, AND WHY THIS ONE.
///   A lock keys on (course, section, semester) because that triple is exactly
///   what one faculty member is responsible for marking — the same tuple
///   FacultyCourseAssignment and Timetable already use to describe a teaching
///   duty. Locking per-student would be unenforceable in bulk marking, and
///   locking per-semester alone would freeze a department's finished courses
///   and its unfinished ones together.
///
/// "SEMESTER LOCK" AND "ATTENDANCE FREEZE" ARE THE SAME MECHANISM.
///   fromDate and toDate are both nullable. Null-null means the whole semester
///   — the README's "Semester Lock". A supplied range is the README's partial
///   "Attendance Freeze". One model, one enforcement predicate, no second
///   concept that could disagree with the first.
///
/// THE ROW IS UNIQUE, THE HISTORY IS NOT.
///   The unique key means one lock state per teaching unit — locking twice
///   updates rather than duplicating. Every transition is written to AuditLog
///   by the service, which is where the audit endpoint reads from; this table
///   holds only the CURRENT state.
model AttendanceLock {
  id       String @id @default(cuid())
  tenantId String

  courseId   String
  sectionId  String
  semesterId String

  /// Inclusive lower bound of the frozen window. NULL = from the beginning of
  /// the semester. @db.Date to match Attendance.date, which is also a bare
  /// date — comparing a timestamp against it would make the boundary depend on
  /// the server's timezone.
  fromDate DateTime? @db.Date

  /// Inclusive upper bound. NULL = to the end of the semester.
  toDate DateTime? @db.Date

  status AttendanceLockStatus @default(LOCKED)

  /// Why the lock was taken. Optional, and deliberately present: TD-008 and
  /// TD-C20 both record that a consequential state change with no reason column
  /// is unattributable after the fact. This phase does not repeat that.
  reason String?

  lockedById String?
  lockedAt   DateTime @default(now())

  unlockedById String?
  unlockedAt   DateTime?
  unlockReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course   Course   @relation(fields: [courseId], references: [id])
  section  Section  @relation(fields: [sectionId], references: [id])
  semester Semester @relation(fields: [semesterId], references: [id])

  /// SetNull on both actors: DELETE /api/users/[id] is a hard delete, and a
  /// Restrict here would start rejecting it. AuditLog holds the permanent,
  /// actor-preserving record of who locked what.
  lockedBy   User? @relation("AttendanceLockLockedBy", fields: [lockedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  unlockedBy User? @relation("AttendanceLockUnlockedBy", fields: [unlockedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// One lock state per teaching unit.
  @@unique([tenantId, courseId, sectionId, semesterId])
  /// The enforcement read, performed on EVERY attendance write: is this unit
  /// locked right now?
  @@index([tenantId, status])
  @@index([courseId])
  @@index([sectionId])
  @@index([semesterId])
}

/// Phase 23 — one research publication on a faculty profile.
///
/// A TABLE RATHER THAN A JSON COLUMN. The README treats publications as a
/// countable, listable part of a profile, and TD-C04 already records what an
/// unstructured Json blob costs: nothing can validate it, nothing can query it,
/// and the mismatch surfaces at render time. Achievement (Phase 18) set the
/// precedent for modelling this kind of list relationally.
model FacultyPublication {
  id        String @id @default(cuid())
  tenantId  String
  facultyId String

  title      String
  /// Journal, conference or publisher name.
  publisher  String?
  /// DOI, ISBN or an arbitrary reference string the institution recognises.
  identifier String?
  url        String?

  publishedOn DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faculty FacultyMember @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  /// The profile read: one faculty member's publications, newest first.
  @@index([tenantId, facultyId, publishedOn])
  /// Supports the cascade. PostgreSQL does not index a foreign key
  /// automatically, and without this a faculty deletion sequentially scans.
  @@index([facultyId])
}

/// Phase 23 — one professional certification held by a faculty member.
model FacultyCertification {
  id        String @id @default(cuid())
  tenantId  String
  facultyId String

  name   String
  issuer String?
  url    String?

  issuedOn DateTime?

  /// Nullable because many certifications never expire. Nothing in this phase
  /// compares it to the current time — reporting an expiry the caller
  /// interprets is the same choice Certificate.expiresAt made (TD-C32), stated
  /// here so it is a decision rather than an omission.
  expiresOn DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faculty FacultyMember @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([tenantId, facultyId, issuedOn])
  @@index([facultyId])
}

/// Phase 23 — one entry in a faculty member's education history.
///
/// Distinct from FacultyMember.qualification, which is a single free-text
/// summary Phase 7 already stores and this phase does not touch. That column
/// answers "what is their highest qualification"; these rows answer "where did
/// they study, and when".
model FacultyEducation {
  id        String @id @default(cuid())
  tenantId  String
  facultyId String

  degree       String
  institution  String
  fieldOfStudy String?

  /// Years rather than dates: an education record is conventionally stated in
  /// years, and storing a fabricated day-precision date would assert precision
  /// the source never had.
  startYear Int?
  endYear   Int?

  grade String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faculty FacultyMember @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([tenantId, facultyId, endYear])
  @@index([facultyId])
}

/// Phase 24 — a superseded assignment submission attempt.
///
/// WHY A CHILD TABLE AND NOT A RELAXED UNIQUE CONSTRAINT.
///   AssignmentSubmission declares a unique key on (assignmentId, studentId)
///   and every Phase 10 route — the grade path especially — is written against
///   "one row per student". Dropping that constraint to get history would
///   change the meaning of code this phase is not permitted to touch. Instead
///   the parent row remains the CURRENT attempt, and each resubmission
///   snapshots the outgoing state here first.
///
/// WHAT A ROW MEANS
///   The submission AS IT STOOD before the attempt that replaced it, including
///   any marks and feedback it had already received. A student who resubmits
///   after grading therefore does not erase the grade that was given — it is
///   preserved on the version, which is the point of an audit trail.
model AssignmentSubmissionVersion {
  id           String @id @default(cuid())
  submissionId String

  /// 1-based, monotonic within one submission, never reused. Assigned by the
  /// service inside the same transaction as the update, so two concurrent
  /// resubmissions cannot both claim the same number — the unique index below
  /// is what makes that guarantee structural rather than hopeful.
  attempt Int

  status      SubmissionStatus
  attachments Json?
  submittedAt DateTime?

  marks    Int?
  feedback String?
  gradedAt DateTime?
  gradedBy String?

  /// When this version was superseded — i.e. when the snapshot was taken. Not
  /// the same as submittedAt, which is when the student originally sent it.
  recordedAt DateTime @default(now())

  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, attempt])
  @@index([submissionId])
}

/// Phase 25 — one AI-generated internal-mark suggestion, and the faculty
/// decision taken on it.
///
/// ONE ROW CARRIES BOTH, DELIBERATELY.
///   The README frames this as "AI suggests, faculty decides". Splitting the
///   suggestion and the override into two tables would make the ordinary
///   question — what was proposed, what was awarded, and how far apart were
///   they — a join, and would allow a decision to exist with no proposal behind
///   it. Keeping them on one row makes the pairing structural.
///
/// THE MARKING RULES ARE NOT STORED HERE.
///   The rules endpoint reads Phase 16's EvaluationComponent weightages for the
///   active EvaluationScheme. No parallel rules model is declared: a university
///   that has configured its internal components has already stated how
///   internal marks are weighted, and a second store would be free to
///   contradict it.
///
/// THE AUDIT TRAIL IS AuditLog, NOT A COLUMN HERE.
///   Every generate and every override is written to AuditLog by the service,
///   which is what the audit endpoint reads. This row holds current state;
///   AuditLog holds the sequence of changes, exactly as Phase 22 does for
///   attendance locks.
model InternalAssessmentSuggestion {
  id       String @id @default(cuid())
  tenantId String

  studentId  String
  courseId   String
  semesterId String

  /// The Phase 16 EvaluationComponent this suggestion is FOR. A plain column
  /// rather than a relation: EvaluationComponent is Phase 16's aggregate and
  /// this phase adds no back-relation to it. The service validates that the
  /// component exists, belongs to the tenant, and is an internal component.
  componentId String

  /// What the model proposed. Decimal(6,2) matching every other marks column in
  /// the project (ExamResult.marksObtained, StudentComponentScore), so a
  /// suggestion and an awarded mark are directly comparable with no conversion.
  suggestedMarks Decimal? @db.Decimal(6, 2)

  /// How much of the evidence the suggestion was actually based on, 0.000-1.000.
  ///
  /// DEFINED, NOT INVENTED. This is the DATA-COMPLETENESS ratio: the fraction
  /// of the configured evidence inputs (attendance, assignments, quiz,
  /// practical, prior performance) for which this student had any data at all.
  /// It is NOT a claim about how likely the number is to be right, which
  /// nothing in the README defines and nothing here could honestly compute.
  /// lib/domain/internal-assessment/confidence.ts is the single definition.
  confidence Decimal? @db.Decimal(4, 3)

  /// The per-input evidence the suggestion was computed from, as the domain
  /// layer assembled it. Stored so a suggestion can be explained months later
  /// without re-reading attendance and assignment tables that have since moved.
  factors Json?

  /// The model's prose rationale, when one was produced. Nullable because a
  /// suggestion generated with no AI provider configured is still a valid
  /// deterministic suggestion — see the service.
  rationale String?

  /// Which Groq model produced it, so a suggestion is reproducible and a
  /// provider change is visible in the data.
  aiModel String?

  generatedById String?
  generatedAt   DateTime @default(now())

  /// What the faculty member actually awarded. NULL until a decision is taken.
  finalMarks Decimal? @db.Decimal(6, 2)

  /// Required by the service whenever finalMarks differs from suggestedMarks.
  /// The schema cannot express "required only when they differ", so the rule
  /// lives in the service and this column stays nullable — stated so the gap is
  /// a known one rather than an oversight.
  overrideReason String?

  decidedById String?
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course   Course   @relation(fields: [courseId], references: [id])
  semester Semester @relation(fields: [semesterId], references: [id])

  generatedBy User? @relation("InternalAssessmentGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  decidedBy   User? @relation("InternalAssessmentDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// One suggestion per student per component per course-semester. Regenerating
  /// updates in place rather than accumulating proposals nothing distinguishes.
  @@unique([tenantId, studentId, courseId, semesterId, componentId])
  /// The faculty read: everyone in this course-semester, for review in bulk.
  @@index([tenantId, courseId, semesterId])
  @@index([studentId])
}

/// Phase 26 — what kind of examination resource a row holds.
///
/// Exactly the six the README's faculty upload list names, and no others.
enum ExamResourceType {
  QUESTION_PAPER
  SOLUTION
  MARKING_SCHEME
  ANSWER_KEY
  REFERENCE_MATERIAL
  FORMULA_SHEET
}

/// Phase 26 — publication lifecycle of a resource.
///
/// DRAFT     — uploaded, visible to its uploader and the department, never to a
///             student. The README's "Draft Mode".
/// PUBLISHED — released. Student visibility ALSO requires any scheduled time to
///             have elapsed; see ExamResource.scheduledPublishAt.
/// ARCHIVED  — withdrawn. Retained and readable by staff, never listed to a
///             student. Not a delete: previous-year papers are the point of the
///             repository, so nothing here destroys one.
enum ExamResourceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Phase 26 — one question paper, solution, marking scheme or reference file.
///
/// THIS MODEL STORES A LOCATION, NOT A FILE.
///   No upload, R2 client, presigned-URL helper or multipart handler exists
///   anywhere in this repository — verified before this model was written.
///   StudentDocument, Certificate.pdfUrl and AssignmentSubmission.attachments
///   all store a client-supplied URL, and the Phase 17 download route returns
///   JSON rather than bytes. Phase 26 follows that precedent exactly rather
///   than inventing a second file convention this project cannot serve.
///
/// SCHEDULED PUBLICATION IS EVALUATED ON READ.
///   The project has no cron, queue or job runner. scheduledPublishAt is
///   therefore a stored instant that every student-facing query compares
///   against now(); nothing flips a column on a timer. This makes the feature
///   real with no infrastructure that does not exist, at the cost of a resource
///   remaining PUBLISHED-but-not-yet-visible rather than transitioning.
///
/// VERIFICATION IS ORTHOGONAL TO PUBLICATION.
///   The README gives HOD "Verify Uploads" AND "Publish/Unpublish" as separate
///   capabilities, so isVerified is a separate flag and does NOT gate student
///   visibility. A published-but-unverified resource is visible; verification
///   is a quality signal reported alongside it.
model ExamResource {
  id       String @id @default(cuid())
  tenantId String

  courseId   String
  semesterId String

  /// Denormalised from the course for the README's "Department Repository"
  /// read, which lists everything a department has produced without joining
  /// through every course. Written by the service from the course's own
  /// department, never accepted from the client.
  departmentId String?

  /// Optional link to the examination the paper was set for. Nullable because
  /// reference material and formula sheets belong to a course, not a sitting.
  /// A plain column with no relation: Examination is Phase 10's aggregate and
  /// this phase adds no back-relation to it.
  examinationId String?

  type  ExamResourceType
  title String

  description String?

  /// The academic year the resource belongs to, e.g. "2024-25". A string
  /// because that is how an institution writes it and how the README's
  /// "Previous Year Question Papers" filter reads; AcademicYear rows exist but
  /// a paper may predate the tenant's records entirely.
  academicYear String?

  fileName String
  fileUrl  String
  fileSize Int?
  mimeType String?

  status ExamResourceStatus @default(DRAFT)

  /// When the resource becomes student-visible. NULL means "as soon as it is
  /// PUBLISHED". Compared to now() on every student read — nothing mutates it.
  scheduledPublishAt DateTime?

  publishedAt DateTime?
  archivedAt  DateTime?

  isVerified   Boolean   @default(false)
  verifiedById String?
  verifiedAt   DateTime?

  uploadedById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course     Course      @relation(fields: [courseId], references: [id])
  semester   Semester    @relation(fields: [semesterId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  /// Restrict on the uploader, SetNull on the verifier. The two differ on
  /// purpose: a resource with no uploader is unattributable provenance for a
  /// document students rely on, whereas a verification is a review event whose
  /// permanent record is AuditLog.
  uploadedBy User  @relation("ExamResourceUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  verifiedBy User? @relation("ExamResourceVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// The student read: published resources for a course in a semester.
  @@index([tenantId, status, courseId, semesterId])
  /// The department repository read.
  @@index([tenantId, departmentId, status])
  /// Previous-year browsing.
  @@index([tenantId, academicYear])
  @@index([courseId])
  @@index([semesterId])
  @@index([uploadedById])
}

/// Phase 27 — WHAT a notification or announcement is about.
///
/// Exactly the eleven the README's "Notification Categories" list names.
/// Independent of NotificationType, which is the delivery CHANNEL — see the
/// note on Notification.category for why conflating them was rejected.
enum NotificationCategory {
  ACADEMIC
  ATTENDANCE
  ASSIGNMENT
  RESULT
  FEE
  CERTIFICATE
  TIMETABLE
  AI
  FINANCE
  ANNOUNCEMENT
  EMERGENCY
}

/// Phase 27 — who an announcement is addressed to.
///
/// The four the README names, in widening-to-narrowing order. Each member
/// implies exactly one nullable target column on Announcement; the service
/// refuses a mismatch (DEPARTMENT with no departmentId, INSTITUTION with one).
enum AnnouncementAudience {
  INSTITUTION
  DEPARTMENT
  BATCH
  SECTION
}

/// Phase 27 — publication lifecycle of an announcement.
enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Phase 27 — one announcement, addressed to an audience rather than a person.
///
/// RESOLVED ON READ, NEVER FANNED OUT.
///   Publishing does NOT write one Notification per recipient. A batch-wide
///   announcement in a large university would be tens of thousands of rows per
///   post; editing one would then have to find and rewrite all of them, and
///   deleting one would leave orphans. Instead the audience is stored on the
///   single row and the list endpoint resolves what the CALLER is entitled to
///   see at query time. One row, one edit, one delete.
///
/// SCHEDULING, LIKE PHASE 26, IS EVALUATED ON READ.
///   publishAt is compared to now() by the visibility predicate. No job runner
///   exists to flip a status column, and inventing one is outside this phase.
model Announcement {
  id       String @id @default(cuid())
  tenantId String

  title String
  body  String

  category NotificationCategory @default(ANNOUNCEMENT)

  audience AnnouncementAudience @default(INSTITUTION)

  /// Exactly one of these is set, matching audience; all three are NULL for
  /// INSTITUTION. The schema cannot express that exclusivity, so the service
  /// enforces it — recorded here as a known structural gap rather than left
  /// implicit.
  departmentId String?
  batchId      String?
  sectionId    String?

  status AnnouncementStatus @default(DRAFT)

  /// The README's "Pinned Announcements". Ordering key, not a visibility rule:
  /// a pinned announcement sorts first and is otherwise ordinary.
  isPinned Boolean @default(false)

  /// The README's "Scheduled Announcements". NULL = visible as soon as it is
  /// PUBLISHED.
  publishAt DateTime?

  /// After this instant the announcement stops being listed. Nullable; nothing
  /// deletes on expiry.
  expiresAt DateTime?

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])
  batch      Batch?      @relation(fields: [batchId], references: [id])
  section    Section?    @relation(fields: [sectionId], references: [id])

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  reads AnnouncementRead[]

  /// The list read: what is live in this tenant, pinned first, newest first.
  @@index([tenantId, status, isPinned, publishAt])
  @@index([departmentId])
  @@index([batchId])
  @@index([sectionId])
}

/// Phase 27 — that one user has read one announcement.
///
/// A JOIN TABLE RATHER THAN A COLUMN, because read state is per-VIEWER and an
/// announcement has many. Its absence means unread, so nothing has to be
/// written when an announcement is published — only when someone reads it.
model AnnouncementRead {
  id             String @id @default(cuid())
  announcementId String
  userId         String

  readAt DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One read record per user per announcement. Marking read twice is
  /// idempotent rather than a second row.
  @@unique([announcementId, userId])
  @@index([userId])
}

/// ============================================================================
/// ADMISSIONS (W3 — PRD §8.2, §8.5, §9.1, §49.2)
///
/// One model, plus a preference join. Nothing here duplicates Student, User or
/// Parent: an Application is the record of somebody who is NOT yet a student,
/// and it points at the Student it became once §8.5 conversion has run.
/// ============================================================================

/// PRD §49.2 — the Student Admission Workflow, verbatim and in order.
///
/// These twelve values are the PRD's own arrow-chain: "Lead → Counselling →
/// Application → Document Verification → Eligibility Check → Entrance
/// Examination → Merit or Selection → Offer Letter → Fee Payment → Student ID
/// Generation → Course Allocation → Portal Activation". No stage is added,
/// renamed, split or reordered, and no status outside this list exists —
/// §8 defines none.
enum AdmissionStage {
  LEAD
  COUNSELLING
  APPLICATION
  DOCUMENT_VERIFICATION
  ELIGIBILITY_CHECK
  ENTRANCE_EXAMINATION
  MERIT_OR_SELECTION
  OFFER_LETTER
  FEE_PAYMENT
  STUDENT_ID_GENERATION
  COURSE_ALLOCATION
  PORTAL_ACTIVATION
}

/// An admission application (PRD §8.2).
model Application {
  id       String @id @default(cuid())
  tenantId String

  /// PRD §9.1 "Applicant ID" and "Application number".
  ///
  /// Both, because §9.1 names both. They are issued by the EXISTING identifier
  /// engine (PRD §9) and never by this model — no default, no autoincrement.
  applicantNo   String
  applicationNo String

  /// Applicant details (§8.2).
  firstName   String
  lastName    String
  email       String
  phone       String?
  dateOfBirth DateTime?

  /// Guardian information (§8.2).
  ///
  /// Held on the application rather than as a Parent row: an applicant is not
  /// yet a student, so there is no Student for StudentParent to join to.
  /// Conversion is where a Parent record would be created, and §8.5 does not
  /// ask for one — recorded as a gap rather than guessed at.
  guardianName     String?
  guardianRelation String?
  guardianPhone    String?
  guardianEmail    String?

  /// Education and work history (§8.2 "Education history",
  /// "Work-experience history").
  ///
  /// UNTYPED JSON, deliberately. §8.2 names both and defines no field for
  /// either — no institution, no year, no grade, no employer. Imposing a shape
  /// would be inventing the requirement, so the column stores what is supplied
  /// and the validator bounds only its size and depth. Same treatment as
  /// Tenant.address and Tenant.settings.
  educationHistory Json?
  workHistory      Json?

  /// PRD §49.2. Every application starts at the first stage.
  stage AdmissionStage @default(LEAD)

  /// PRD §8.5 — the Student this application became, once converted.
  ///
  /// Nullable because most applications have not converted, and @unique so one
  /// application can produce at most one student. This column is what makes
  /// duplicate conversion impossible at the database rather than in a service.
  studentId   String?   @unique
  convertedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student     Student?                @relation(fields: [studentId], references: [id])
  preferences ApplicationPreference[]

  /// Both identifiers are unique per tenant, matching every other identifier in
  /// this schema. The email is unique per tenant too: §8.3 asks for "Duplicate
  /// application detection", and one address applying twice to one university
  /// is what that means in the terms this model has.
  @@unique([tenantId, applicationNo])
  @@unique([tenantId, applicantNo])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, stage])
}

/// PRD §8.2 "Multiple programme preferences".
///
/// A join rather than a column, because "multiple" is the requirement. The
/// composite key stops one programme being listed twice for one application.
model ApplicationPreference {
  applicationId String
  programmeId   String

  /// 1 is the applicant's first choice. Ordering is the whole point of a
  /// preference list, so it is stored rather than inferred from insert order.
  priority Int

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  programme   Programme   @relation(fields: [programmeId], references: [id])

  @@id([applicationId, programmeId])
  @@index([applicationId])
}

/// ============================================================================
/// WEBSITE CMS (PRD §7 — Public University Website and Marketing CMS)
///
/// THE SHAPE: BLOCKS AS JSON, MEANING AS CODE
///   A page is an ORDERED ARRAY of { id, type, props } stored in one Json
///   column. What each `type` means — its fields, its validation, its React
///   component — lives in lib/domain/cms/blocks, not in the database.
///
///   The alternative, a Block table with a parent, an order column and typed
///   columns per block kind, was rejected deliberately. Rendering one page
///   would become N queries, reordering two blocks would become an UPDATE
///   storm across every row after the move, and adding a block type would
///   become a migration. None of that buys anything a Json column does not
///   already give, because nothing ever queries INSIDE a page's blocks — a
///   page is always read whole, by path.
///
///   The cost is real and accepted: the database cannot validate block props.
///   Zod does, on every write, from the same schema the renderer reads.
///
/// WHY DRAFT AND PUBLISHED ARE TWO COLUMNS ON ONE ROW
///   An editor must be able to save a half-finished page without that page
///   going live, which is the whole of §7.3 "Draft and approval workflows".
///   Two columns express that with no join and no pointer to keep consistent:
///   the public renderer reads `publishedBlocks` and never looks at the draft,
///   the editor reads and writes `draftBlocks` and never touches the published
///   copy, and publishing is one assignment.
///
///   §7.3 also asks for "Version history", which two columns cannot give — so
///   CmsPageVersion below records a snapshot on every publish. History is
///   therefore a log of what was PUBLISHED, not of every keystroke saved. That
///   is the useful definition: "what did the site say last Tuesday" is a
///   question about published content.
/// ============================================================================

/// A platform-owned starting point for a tenant's page. PRD §5.1 "Import
/// initial university data", §45 "Document templates".
///
/// NOT A TENANT ROW, AND THAT IS THE POINT
///   It has no tenantId because it belongs to the platform owner. Onboarding
///   copies its blocks into the new university's CmsPage, after which the two
///   are unrelated: the tenant edits their copy freely and nothing pushes back.
///
///   A COPY, NOT A REFERENCE. A tenant whose landing page silently changed
///   because the platform edited a shared template would have no way to
///   understand what happened, and no way to refuse it. Push-on-change was
///   considered and rejected — it needs per-block "has the tenant overridden
///   this" tracking, which is a much larger design than seeding is worth.
model CmsTemplate {
  id String @id @default(cuid())

  /// Stable identifier used by the seeder and by onboarding, e.g.
  /// "default-landing". Unique so a template can be fetched without knowing
  /// its cuid.
  key String @unique

  name        String
  description String?

  /// The ordered block array. Same shape and the same registry as
  /// CmsPage.draftBlocks — a template IS a page body with no tenant.
  blocks Json

  /// The chrome the template starts a university with: the navigation bar with
  /// its dropdowns, the footer columns and the social accounts. Same schemas as
  /// the matching CmsSite columns, so onboarding copies them across without a
  /// translation step.
  ///
  /// NULLABLE, AND THAT IS THE PRE-EXISTING-ROW CASE
  ///   The default template was seeded before these columns existed. Null means
  ///   "the template has no opinion", and onboarding then falls back to the
  ///   seeder's own defaults rather than giving a new university an empty menu.
  navItems      Json?
  footerColumns Json?
  socialLinks   Json?

  /// Site-wide typography defaults — heading and body colour, size step and
  /// weight. Validated by typographySchema; see lib/domain/cms/typography.ts on
  /// why size and weight are closed vocabularies and colour is strict hex.
  typography Json?

  /// Optional enquire dock handed to a new university. Same schema as
  /// CmsSite.enquireRail so onboarding is a copy, not a conversion.
  enquireRail Json?

  /// The platform operator who last wrote it. Nullable because an operator can
  /// leave and the template must survive them.
  updatedById String?
  updatedBy   PlatformUser? @relation("CmsTemplateEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One page of one university's public website. PRD §7.1.
///
/// PATH IS THE IDENTITY, SCOPED TO THE TENANT
///   "/" is the landing page; "/admissions" would be another. The unique
///   constraint is composite because two universities both have a "/", and a
///   globally unique path would let the first tenant to claim one lock every
///   other tenant out of it.
model CmsPage {
  id       String @id @default(cuid())
  tenantId String

  /// Always stored with a leading slash and no trailing slash, "/" excepted.
  /// Normalised on write so "/admissions" and "admissions/" cannot become two
  /// pages that render the same URL.
  path String

  title String

  status CmsPageStatus @default(DRAFT)

  /// What the editor is working on. Never rendered publicly.
  draftBlocks Json

  /// What the public sees. NULL until the page has been published even once,
  /// which is what lets a page exist in draft without its URL going live.
  publishedBlocks Json?

  publishedAt   DateTime?
  publishedById String?
  publishedBy   User?     @relation("CmsPagePublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  /// PRD §7.3 "SEO metadata". Plain columns rather than a Json blob: these
  /// three are read on every render to build <head>, and a blob would mean
  /// parsing untyped JSON on the hottest path on the site.
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions CmsPageVersion[]

  /// The public read: one page, by tenant and path.
  @@unique([tenantId, path])
  @@index([tenantId, status])
}

/// A snapshot of what was published, written once per publish. PRD §7.3
/// "Version history".
///
/// IMMUTABLE BY CONVENTION AND BY SHAPE
///   Nothing updates a version row: there is no updatedAt and no service that
///   writes one twice. Rolling back copies a version's blocks into the page's
///   DRAFT rather than re-pointing the page at it, so the editor sees what they
///   are about to restore and publishes it deliberately. A rollback that went
///   straight to live would be an unreviewed publish.
model CmsPageVersion {
  id     String @id @default(cuid())
  pageId String

  /// Denormalised from the page so history can be read and access-checked
  /// without a join, and so a version cannot be orphaned into another tenant's
  /// scope by a bug in a page write.
  tenantId String

  /// Monotonic per page, starting at 1. Unique with pageId so two concurrent
  /// publishes cannot both claim the same number.
  versionNo Int

  blocks Json

  /// Free-text note from the publisher, e.g. "added spring intake banner".
  note String?

  createdById String?
  createdBy   User?    @relation("CmsVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  page CmsPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, versionNo])
  @@index([tenantId])
}

enum CmsPageStatus {
  /// Never published, or unpublished since. The URL 404s publicly.
  DRAFT

  /// publishedBlocks is live at the page's path.
  PUBLISHED

  /// Was published, deliberately withdrawn. Distinct from DRAFT so an editor
  /// can tell "not finished yet" from "taken down".
  ARCHIVED
}

/// The chrome around every page of one university's website: the navigation
/// bar, the footer columns, the contact details and the social links.
/// PRD §7.3 "Redirect management" neighbours; §7.1 site-wide furniture.
///
/// WHY THIS IS NOT A BLOCK
///   Blocks are page BODY. The header and footer wrap every page, so storing
///   them in a page's block array would mean repeating them on each page and
///   editing the navigation N times to add one menu item.
///
/// ONE ROW PER TENANT, ENFORCED BY THE SCHEMA
///   tenantId is unique rather than merely indexed. Two navigation rows for one
///   university is a state with no correct resolution — whichever the query
///   happened to return would win — so it is made unrepresentable instead.
model CmsSite {
  id       String @id @default(cuid())
  tenantId String @unique

  /// Ordered [{ label, href, children?: [{ label, href, description? }] }].
  /// Validated by navItemsSchema on write.
  ///
  /// ONE LEVEL OF NESTING. A child cannot have children of its own — the
  /// schema makes it unrepresentable rather than the renderer refusing to draw
  /// it. Two levels is a menu; three is a sitemap operated with a mouse held
  /// very still, and no reference university site goes past two.
  navItems Json

  /// Ordered [{ heading, links: [{ label, href }] }] — the footer's columns.
  footerColumns Json

  /// Ordered [{ platform, href }], platform constrained to a known set so the
  /// renderer can map it to an icon without trusting stored text.
  socialLinks Json

  /// Shown in the footer's contact column. Nullable individually: an
  /// institution that publishes an address but not a phone number is ordinary.
  contactAddress String?
  contactPhone   String?
  contactEmail   String?

  /// Site-wide typography: heading and body colour, size step and weight.
  ///
  /// SITE-WIDE RATHER THAN PER PAGE, because it is the institution's voice and
  /// not one page's layout. A block's own `style` overrides it for one section;
  /// nothing in code merges the two — the browser's cascade does, which is why
  /// only the properties actually set are ever emitted. See
  /// lib/domain/cms/typography.ts.
  ///
  /// NULL means the design system's own type, which is the correct default and
  /// not a fallback worth apologising for.
  typography Json?

  /// Optional enquire dock: { enabled, label, items: [{ label, href, icon? }] }.
  /// Validated by enquireRailSchema. Null means "not configured" — the public
  /// site then draws nothing, which is the correct default for institutions
  /// that never open the chrome editor.
  enquireRail Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}
