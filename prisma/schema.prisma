generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum InstitutionType {
  UNIVERSITY
  COLLEGE
  INSTITUTE
  SCHOOL
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

enum DomainType {
  PRIMARY
  CUSTOM
  SUBDOMAIN
}

enum SubscriptionPlan {
  STARTER
  GROWTH
  ENTERPRISE
  CUSTOM
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIAL
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

enum ProgrammeType {
  UNDERGRADUATE
  POSTGRADUATE
  DIPLOMA
  CERTIFICATE
  PHD
  INTEGRATED
}

enum DurationUnit {
  YEARS
  MONTHS
  SEMESTERS
}

enum CourseType {
  CORE
  ELECTIVE
  AUDIT
  LAB
  PROJECT
  SEMINAR
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  WITHDRAWN
  SUSPENDED
  ON_LEAVE
  TRANSFERRED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
  RETIRED
}

enum EmployeeType {
  TEACHING
  NON_TEACHING
  VISITING
  ADJUNCT
  CONTRACT
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SessionType {
  LECTURE
  LAB
  TUTORIAL
  SEMINAR
  EXAM
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AssignmentType {
  HOMEWORK
  PROJECT
  QUIZ
  ESSAY
  PRESENTATION
  LAB_REPORT
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  GRADED
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  LATE
  GRADED
  RETURNED
}

enum ExaminationType {
  INTERNAL
  EXTERNAL
  SUPPLEMENTARY
  PRACTICAL
  VIVA
  MID_TERM
  END_TERM
}

enum ExamStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
  POSTPONED
}

enum FeeType {
  TUITION
  HOSTEL
  TRANSPORT
  LIBRARY
  LAB
  EXAM
  REGISTRATION
  ACTIVITY
  MISCELLANEOUS
}

enum FeeStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  WAIVED
}

enum PaymentMethod {
  ONLINE
  CASH
  CHEQUE
  DD
  NEFT
  UPI
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIAL
}

enum CertificateType {
  DEGREE
  DIPLOMA
  TRANSCRIPT
  BONAFIDE
  MIGRATION
  CONDUCT
  COMPLETION
  PROVISIONAL
  CUSTOM
}

enum NotificationType {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum SequenceReset {
  NEVER
  YEARLY
  MONTHLY
  SEMESTERLY
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum DocumentType {
  PHOTO
  AADHAAR
  PAN
  PASSPORT
  BIRTH_CERTIFICATE
  MARKSHEET
  TRANSFER_CERTIFICATE
  INCOME_CERTIFICATE
  CATEGORY_CERTIFICATE
  OTHER
}

// ─────────────────────────────────────────────
// PLATFORM / MULTI-TENANCY
// ─────────────────────────────────────────────

model Tenant {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String
  type            InstitutionType @default(UNIVERSITY)
  status          TenantStatus    @default(TRIAL)
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String?
  accentColor     String?
  timezone        String          @default("Asia/Kolkata")
  locale          String          @default("en")
  country         String          @default("IN")
  address         Json?
  contactEmail    String?
  contactPhone    String?
  website         String?
  accreditationNo String?
  establishedYear Int?
  settings        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  domains       Domain[]
  subscriptions Subscription[]
  invoices      PlatformInvoice[]
  users         User[]
  roles         Role[]
  campuses      Campus[]
  academicYears AcademicYear[]
  idSequences   IdSequence[]
  certTemplates CertificateTemplate[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([slug])
  @@index([status])
}

model Domain {
  id        String     @id @default(cuid())
  tenantId  String
  domain    String     @unique
  type      DomainType @default(SUBDOMAIN)
  verified  Boolean    @default(false)
  isPrimary Boolean    @default(false)
  createdAt DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([domain])
}

model Subscription {
  id             String             @id @default(cuid())
  tenantId       String
  plan           SubscriptionPlan   @default(STARTER)
  status         SubscriptionStatus @default(TRIAL)
  billingCycle   BillingCycle       @default(MONTHLY)
  startDate      DateTime
  endDate        DateTime?
  trialEndsAt    DateTime?
  maxStudents    Int?
  maxFaculty     Int?
  maxStorage     BigInt?
  features       Json?
  pricePerMonth  Decimal?           @db.Decimal(10, 2)
  currency       String             @default("INR")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices PlatformInvoice[]

  @@index([tenantId])
}

model PlatformInvoice {
  id             String        @id @default(cuid())
  tenantId       String
  subscriptionId String?
  invoiceNo      String        @unique
  amount         Decimal       @db.Decimal(10, 2)
  tax            Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  currency       String        @default("INR")
  status         InvoiceStatus @default(DRAFT)
  dueDate        DateTime?
  paidAt         DateTime?
  paymentRef     String?
  notes          String?
  lineItems      Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([tenantId])
}

// ─────────────────────────────────────────────
// AUTH / RBAC
// ─────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  tenantId     String
  email        String
  phone        String?
  passwordHash String
  firstName    String
  lastName     String
  displayName  String?
  avatarUrl    String?
  isActive     Boolean   @default(true)
  isVerified   Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions  Session[]
  userRoles UserRole[]

  faculty  FacultyMember?
  employee Employee?
  student  Student?

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  refreshToken String?  @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id       String @id @default(cuid())
  resource String
  action   String
  scope    String @default("*")

  rolePermissions RolePermission[]

  @@unique([resource, action, scope])
}

model RolePermission {
  roleId       String
  permissionId String
  grantedAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId    String
  roleId    String
  scope     Json?
  grantedAt DateTime @default(now())
  grantedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// ─────────────────────────────────────────────
// INSTITUTIONAL HIERARCHY
// ─────────────────────────────────────────────

model Campus {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String
  address   Json?
  phone     String?
  email     String?
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schools     School[]
  departments Department[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model School {
  id        String   @id @default(cuid())
  tenantId  String
  campusId  String
  name      String
  code      String
  deanName  String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campus      Campus      @relation(fields: [campusId], references: [id], onDelete: Cascade)
  departments Department[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([campusId])
}

model Department {
  id        String   @id @default(cuid())
  tenantId  String
  campusId  String
  schoolId  String?
  name      String
  code      String
  hodName   String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campus      Campus       @relation(fields: [campusId], references: [id])
  school      School?      @relation(fields: [schoolId], references: [id])
  programmes  Programme[]
  faculty     FacultyMember[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([campusId])
}

model Programme {
  id             String        @id @default(cuid())
  tenantId       String
  departmentId   String
  name           String
  code           String
  type           ProgrammeType @default(UNDERGRADUATE)
  durationValue  Int
  durationUnit   DurationUnit  @default(YEARS)
  totalCredits   Int?
  eligibility    String?
  description    String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  department      Department      @relation(fields: [departmentId], references: [id])
  specialisations Specialisation[]
  batches         Batch[]
  curricula       Curriculum[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([departmentId])
}

model Specialisation {
  id          String   @id @default(cuid())
  tenantId    String
  programmeId String
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  programme Programme @relation(fields: [programmeId], references: [id])
  students  Student[]

  @@unique([tenantId, code])
  @@index([programmeId])
}

// ─────────────────────────────────────────────
// ACADEMIC TIME
// ─────────────────────────────────────────────

model AcademicYear {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  semesters Semester[]
  batches   Batch[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Semester {
  id             String   @id @default(cuid())
  tenantId       String
  academicYearId String
  name           String
  semesterNumber Int
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean  @default(false)
  createdAt      DateTime @default(now())

  academicYear AcademicYear          @relation(fields: [academicYearId], references: [id])
  sections     Section[]
  timetables   Timetable[]
  examinations Examination[]
  feeDemands   FeeDemand[]

  @@unique([academicYearId, semesterNumber])
  @@index([tenantId])
}

model Batch {
  id             String   @id @default(cuid())
  tenantId       String
  programmeId    String
  academicYearId String
  name           String
  code           String
  maxStrength    Int?
  createdAt      DateTime @default(now())

  programme    Programme    @relation(fields: [programmeId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  sections     Section[]
  students     Student[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([programmeId])
}

model Section {
  id         String   @id @default(cuid())
  tenantId   String
  batchId    String
  semesterId String
  name       String
  maxStrength Int?
  createdAt  DateTime @default(now())

  batch      Batch       @relation(fields: [batchId], references: [id])
  semester   Semester    @relation(fields: [semesterId], references: [id])
  students   Student[]
  timetables Timetable[]
  attendance Attendance[]

  @@unique([batchId, semesterId, name])
  @@index([tenantId])
}

// ─────────────────────────────────────────────
// CURRICULUM & COURSES
// ─────────────────────────────────────────────

model Curriculum {
  id            String   @id @default(cuid())
  tenantId      String
  programmeId   String
  name          String
  version       String
  effectiveFrom DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  programme Programme           @relation(fields: [programmeId], references: [id])
  subjects  CurriculumSubject[]

  @@unique([programmeId, version])
  @@index([tenantId])
}

model CurriculumSubject {
  id             String     @id @default(cuid())
  curriculumId   String
  courseId       String
  semesterNumber Int
  isCompulsory   Boolean    @default(true)
  credits        Int
  internalMarks  Int?
  externalMarks  Int?
  createdAt      DateTime   @default(now())

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  course     Course     @relation(fields: [courseId], references: [id])

  @@unique([curriculumId, courseId, semesterNumber])
}

model Course {
  id           String     @id @default(cuid())
  tenantId     String
  departmentId String?
  name         String
  code         String
  type         CourseType @default(CORE)
  credits      Int        @default(3)
  description  String?
  syllabus     String?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  curriculumSubjects   CurriculumSubject[]
  facultyAssignments   FacultyCourseAssignment[]
  timetables           Timetable[]
  assignments          Assignment[]
  examinations         Examination[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([departmentId])
}

// ─────────────────────────────────────────────
// STUDENTS
// ─────────────────────────────────────────────

model Student {
  id               String        @id @default(cuid())
  tenantId         String
  userId           String        @unique
  enrollmentNo     String
  programmeId      String?
  batchId          String?
  sectionId        String?
  specialisationId String?
  currentSemester  Int           @default(1)
  status           StudentStatus @default(ACTIVE)
  admissionDate    DateTime
  graduationDate   DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user           User             @relation(fields: [userId], references: [id])
  batch          Batch?           @relation(fields: [batchId], references: [id])
  section        Section?         @relation(fields: [sectionId], references: [id])
  specialisation Specialisation?  @relation(fields: [specialisationId], references: [id])
  personal       StudentPersonal?
  documents      StudentDocument[]
  parents        StudentParent[]
  attendance     Attendance[]
  submissions    AssignmentSubmission[]
  examResults    ExamResult[]
  feeDemands     FeeDemand[]
  payments       Payment[]
  certificates   Certificate[]

  @@unique([tenantId, enrollmentNo])
  @@index([tenantId])
  @@index([batchId])
  @@index([sectionId])
}

model StudentPersonal {
  id            String     @id @default(cuid())
  studentId     String     @unique
  dateOfBirth   DateTime?
  gender        Gender?
  bloodGroup    BloodGroup?
  nationality   String?
  religion      String?
  category      String?
  motherTongue  String?
  permanentAddr Json?
  localAddr     Json?
  emergencyContact Json?
  disability    Boolean    @default(false)
  disabilityDesc String?
  updatedAt     DateTime   @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model StudentDocument {
  id           String       @id @default(cuid())
  studentId    String
  type         DocumentType
  fileName     String
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  isVerified   Boolean      @default(false)
  verifiedBy   String?
  verifiedAt   DateTime?
  uploadedAt   DateTime     @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model Parent {
  id           String   @id @default(cuid())
  tenantId     String
  firstName    String
  lastName     String
  email        String?
  phone        String
  occupation   String?
  annualIncome Decimal? @db.Decimal(12, 2)
  relation     String
  createdAt    DateTime @default(now())

  students StudentParent[]

  @@index([tenantId])
}

model StudentParent {
  studentId  String
  parentId   String
  isPrimary  Boolean @default(false)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@id([studentId, parentId])
}

// ─────────────────────────────────────────────
// FACULTY / STAFF
// ─────────────────────────────────────────────

model FacultyMember {
  id             String         @id @default(cuid())
  tenantId       String
  userId         String         @unique
  employeeId     String
  departmentId   String?
  designation    String?
  qualification  String?
  specialization String?
  experience     Int?
  status         EmployeeStatus @default(ACTIVE)
  joinDate       DateTime
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user             User                      @relation(fields: [userId], references: [id])
  department       Department?               @relation(fields: [departmentId], references: [id])
  courseAssignments FacultyCourseAssignment[]
  timetables       Timetable[]
  attendance       Attendance[]

  @@unique([tenantId, employeeId])
  @@index([tenantId])
  @@index([departmentId])
}

model FacultyCourseAssignment {
  id          String   @id @default(cuid())
  tenantId    String
  facultyId   String
  courseId    String
  sectionId   String?
  semesterId  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  faculty  FacultyMember @relation(fields: [facultyId], references: [id])
  course   Course        @relation(fields: [courseId], references: [id])

  @@unique([facultyId, courseId, sectionId, semesterId])
  @@index([tenantId])
}

model Employee {
  id           String         @id @default(cuid())
  tenantId     String
  userId       String         @unique
  employeeId   String
  departmentId String?
  designation  String?
  type         EmployeeType   @default(NON_TEACHING)
  status       EmployeeStatus @default(ACTIVE)
  joinDate     DateTime
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([tenantId, employeeId])
  @@index([tenantId])
}

// ─────────────────────────────────────────────
// TIMETABLE & ATTENDANCE
// ─────────────────────────────────────────────

model Timetable {
  id          String      @id @default(cuid())
  tenantId    String
  semesterId  String
  sectionId   String
  courseId    String
  facultyId   String
  day         DayOfWeek
  startTime   String
  endTime     String
  roomNo      String?
  sessionType SessionType @default(LECTURE)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())

  semester Semester      @relation(fields: [semesterId], references: [id])
  section  Section       @relation(fields: [sectionId], references: [id])
  course   Course        @relation(fields: [courseId], references: [id])
  faculty  FacultyMember @relation(fields: [facultyId], references: [id])

  @@index([tenantId])
  @@index([sectionId])
  @@index([facultyId])
}

model Attendance {
  id            String           @id @default(cuid())
  tenantId      String
  studentId     String
  facultyId     String?
  sectionId     String?
  courseId      String?
  date          DateTime         @db.Date
  status        AttendanceStatus @default(PRESENT)
  sessionType   SessionType      @default(LECTURE)
  remarks       String?
  markedAt      DateTime         @default(now())
  markedBy      String?

  student Student        @relation(fields: [studentId], references: [id])
  section Section?       @relation(fields: [sectionId], references: [id])
  faculty FacultyMember? @relation(fields: [facultyId], references: [id])

  @@unique([studentId, courseId, date, sessionType])
  @@index([tenantId])
  @@index([studentId])
  @@index([date])
}

// ─────────────────────────────────────────────
// ASSESSMENTS
// ─────────────────────────────────────────────

model Assignment {
  id           String           @id @default(cuid())
  tenantId     String
  courseId     String
  sectionId    String?
  createdBy    String
  title        String
  description  String?
  type         AssignmentType   @default(HOMEWORK)
  status       AssignmentStatus @default(DRAFT)
  maxMarks     Int              @default(100)
  dueDate      DateTime?
  publishedAt  DateTime?
  attachments  Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  course      Course                 @relation(fields: [courseId], references: [id])
  submissions AssignmentSubmission[]

  @@index([tenantId])
  @@index([courseId])
}

model AssignmentSubmission {
  id           String           @id @default(cuid())
  assignmentId String
  studentId    String
  status       SubmissionStatus @default(PENDING)
  submittedAt  DateTime?
  attachments  Json?
  marks        Int?
  feedback     String?
  gradedAt     DateTime?
  gradedBy     String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    Student    @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

model Examination {
  id          String          @id @default(cuid())
  tenantId    String
  semesterId  String
  courseId    String
  title       String
  type        ExaminationType @default(INTERNAL)
  status      ExamStatus      @default(SCHEDULED)
  date        DateTime?
  startTime   String?
  endTime     String?
  venue       String?
  maxMarks    Int             @default(100)
  passMark    Int?
  duration    Int?
  instructions String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  semester Semester     @relation(fields: [semesterId], references: [id])
  course   Course       @relation(fields: [courseId], references: [id])
  results  ExamResult[]

  @@index([tenantId])
  @@index([semesterId])
  @@index([courseId])
}

model ExamResult {
  id            String    @id @default(cuid())
  examinationId String
  studentId     String
  marksObtained Decimal?  @db.Decimal(6, 2)
  grade         String?
  gradePoint    Decimal?  @db.Decimal(4, 2)
  isPassed      Boolean?
  isAbsent      Boolean   @default(false)
  remarks       String?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  examination Examination @relation(fields: [examinationId], references: [id])
  student     Student     @relation(fields: [studentId], references: [id])

  @@unique([examinationId, studentId])
  @@index([studentId])
}

// ─────────────────────────────────────────────
// FINANCE
// ─────────────────────────────────────────────

model FeeStructure {
  id             String   @id @default(cuid())
  tenantId       String
  programmeId    String?
  batchId        String?
  academicYearId String?
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  components FeeComponent[]
  demands    FeeDemand[]

  @@index([tenantId])
}

model FeeComponent {
  id             String   @id @default(cuid())
  feeStructureId String
  name           String
  type           FeeType  @default(TUITION)
  amount         Decimal  @db.Decimal(10, 2)
  isOptional     Boolean  @default(false)
  isTaxable      Boolean  @default(false)
  taxPercent     Decimal? @db.Decimal(5, 2)
  createdAt      DateTime @default(now())

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@index([feeStructureId])
}

model FeeDemand {
  id             String    @id @default(cuid())
  tenantId       String
  studentId      String
  semesterId     String?
  feeStructureId String?
  dueDate        DateTime
  totalAmount    Decimal   @db.Decimal(10, 2)
  paidAmount     Decimal   @default(0) @db.Decimal(10, 2)
  waivedAmount   Decimal   @default(0) @db.Decimal(10, 2)
  status         FeeStatus @default(PENDING)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student      Student       @relation(fields: [studentId], references: [id])
  semester     Semester?     @relation(fields: [semesterId], references: [id])
  feeStructure FeeStructure? @relation(fields: [feeStructureId], references: [id])
  payments     Payment[]

  @@index([tenantId])
  @@index([studentId])
}

model Payment {
  id            String        @id @default(cuid())
  tenantId      String
  studentId     String
  feeDemandId   String?
  receiptNo     String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod @default(ONLINE)
  status        PaymentStatus @default(PENDING)
  transactionId String?
  gatewayRef    String?
  gatewayMeta   Json?
  paidAt        DateTime?
  remarks       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  student   Student    @relation(fields: [studentId], references: [id])
  feeDemand FeeDemand? @relation(fields: [feeDemandId], references: [id])

  @@index([tenantId])
  @@index([studentId])
}

// ─────────────────────────────────────────────
// CERTIFICATES
// ─────────────────────────────────────────────

model CertificateTemplate {
  id         String          @id @default(cuid())
  tenantId   String
  name       String
  type       CertificateType @default(CUSTOM)
  htmlTemplate String
  cssStyles  String?
  variables  Json?
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  certificates Certificate[]

  @@index([tenantId])
}

model Certificate {
  id           String          @id @default(cuid())
  tenantId     String
  templateId   String
  studentId    String
  certificateNo String         @unique
  type         CertificateType
  data         Json?
  issuedAt     DateTime        @default(now())
  expiresAt    DateTime?
  pdfUrl       String?
  qrCode       String?
  isRevoked    Boolean         @default(false)
  revokedAt    DateTime?
  revokedBy    String?
  createdAt    DateTime        @default(now())

  template CertificateTemplate @relation(fields: [templateId], references: [id])
  student  Student              @relation(fields: [studentId], references: [id])

  @@index([tenantId])
  @@index([studentId])
  @@index([certificateNo])
}

// ─────────────────────────────────────────────
// COMMUNICATIONS
// ─────────────────────────────────────────────

model NotificationTemplate {
  id        String           @id @default(cuid())
  tenantId  String?
  name      String
  type      NotificationType
  subject   String?
  body      String
  variables Json?
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())

  notifications Notification[]

  @@index([tenantId])
}

model Notification {
  id         String           @id @default(cuid())
  tenantId   String
  templateId String?
  userId     String?
  type       NotificationType
  subject    String?
  body       String
  data       Json?
  sentAt     DateTime?
  readAt     DateTime?
  status     String           @default("PENDING")
  error      String?
  createdAt  DateTime         @default(now())

  tenant   Tenant                @relation(fields: [tenantId], references: [id])
  template NotificationTemplate? @relation(fields: [templateId], references: [id])

  @@index([tenantId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// SYSTEM
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  action     String
  resource   String
  resourceId String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
}

model IdSequence {
  id            String        @id @default(cuid())
  tenantId      String
  entityType    String
  prefix        String?
  suffix        String?
  format        String        @default("{PREFIX}{YEAR}{SEQ}")
  padding       Int           @default(4)
  lastSequence  Int           @default(0)
  resetCycle    SequenceReset @default(YEARLY)
  lastResetYear Int?
  lastResetMonth Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entityType])
  @@index([tenantId])
}
