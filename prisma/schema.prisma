generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                String                @id @default(cuid())
  slug              String                @unique
  name              String
  type              InstitutionType       @default(UNIVERSITY)
  status            TenantStatus          @default(TRIAL)
  logoUrl           String?
  faviconUrl        String?
  primaryColor      String?
  accentColor       String?
  timezone          String                @default("Asia/Kolkata")
  locale            String                @default("en")
  country           String                @default("IN")
  address           Json?
  contactEmail      String?
  contactPhone      String?
  website           String?
  accreditationNo   String?
  establishedYear   Int?
  settings          Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  academicYears     AcademicYear[]
  auditLogs         AuditLog[]
  campuses          Campus[]
  certTemplates     CertificateTemplate[]
  domains           Domain[]
  idSequences       IdSequence[]
  notifications     Notification[]
  invoices          PlatformInvoice[]
  roles             Role[]
  subscriptions     Subscription[]
  users             User[]
  evaluationSchemes EvaluationScheme[]
  gradeScales       GradeScale[]

  @@index([slug])
  @@index([status])
}

model Domain {
  id        String     @id @default(cuid())
  tenantId  String
  domain    String     @unique
  type      DomainType @default(SUBDOMAIN)
  verified  Boolean    @default(false)
  isPrimary Boolean    @default(false)
  createdAt DateTime   @default(now())
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([domain])
}

model Subscription {
  id            String             @id @default(cuid())
  tenantId      String
  plan          SubscriptionPlan   @default(STARTER)
  status        SubscriptionStatus @default(TRIAL)
  billingCycle  BillingCycle       @default(MONTHLY)
  startDate     DateTime
  endDate       DateTime?
  trialEndsAt   DateTime?
  maxStudents   Int?
  maxFaculty    Int?
  maxStorage    BigInt?
  features      Json?
  pricePerMonth Decimal?           @db.Decimal(10, 2)
  currency      String             @default("INR")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  invoices      PlatformInvoice[]
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model PlatformInvoice {
  id             String        @id @default(cuid())
  tenantId       String
  subscriptionId String?
  invoiceNo      String        @unique
  amount         Decimal       @db.Decimal(10, 2)
  tax            Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  currency       String        @default("INR")
  status         InvoiceStatus @default(DRAFT)
  dueDate        DateTime?
  paidAt         DateTime?
  paymentRef     String?
  notes          String?
  lineItems      Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  tenant         Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model User {
  id           String         @id @default(cuid())
  tenantId     String
  email        String
  phone        String?
  passwordHash String
  firstName    String
  lastName     String
  displayName  String?
  avatarUrl    String?
  isActive     Boolean        @default(true)
  isVerified   Boolean        @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  employee     Employee?
  faculty      FacultyMember?
  sessions     Session[]
  student      Student?
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles    UserRole[]

  // Phase 16 — back-relations for GradeScale governance attribution. Two
  // relations to the same model must be named to be unambiguous.
  gradeScalesCreated   GradeScale[] @relation("GradeScaleCreatedBy")
  gradeScalesActivated GradeScale[] @relation("GradeScaleActivatedBy")

  // Phase 16 — back-relations for EvaluationScheme governance attribution.
  evaluationSchemesCreated   EvaluationScheme[] @relation("EvaluationSchemeCreatedBy")
  evaluationSchemesActivated EvaluationScheme[] @relation("EvaluationSchemeActivatedBy")

  openElectiveOfferingsCreated OpenElectiveOffering[]

  // Phase 20 — back-relation for FeedbackForm authorship attribution.
  feedbackFormsCreated FeedbackForm[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  refreshToken String?  @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Role {
  id              String           @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id              String           @id @default(cuid())
  resource        String
  action          String
  scope           String           @default("*")
  rolePermissions RolePermission[]

  @@unique([resource, action, scope])
}

model RolePermission {
  roleId       String
  permissionId String
  grantedAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId    String
  roleId    String
  scope     Json?
  grantedAt DateTime @default(now())
  grantedBy String?
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Campus {
  id          String       @id @default(cuid())
  tenantId    String
  name        String
  code        String
  address     Json?
  phone       String?
  email       String?
  isMain      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departments Department[]
  schools     School[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model School {
  id          String       @id @default(cuid())
  tenantId    String
  campusId    String
  name        String
  code        String
  deanName    String?
  email       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
  campus      Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([campusId])
}

model Department {
  id         String          @id @default(cuid())
  tenantId   String
  campusId   String
  schoolId   String?
  name       String
  code       String
  hodName    String?
  email      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  campus     Campus          @relation(fields: [campusId], references: [id])
  school     School?         @relation(fields: [schoolId], references: [id])
  faculty    FacultyMember[]
  programmes Programme[]

  openElectiveOfferings OpenElectiveOffering[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([campusId])
}

model Programme {
  id                  String               @id @default(cuid())
  tenantId            String
  departmentId        String
  name                String
  code                String
  type                ProgrammeType        @default(UNDERGRADUATE)
  durationValue       Int
  durationUnit        DurationUnit         @default(YEARS)
  totalCredits        Int?
  eligibility         String?
  description         String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  batches             Batch[]
  curricula           Curriculum[]
  department          Department           @relation(fields: [departmentId], references: [id])
  specialisations     Specialisation[]
  courseRegistrations CourseRegistration[]

  openElectiveEligibilities OpenElectiveEligibility[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([departmentId])
}

model Specialisation {
  id          String    @id @default(cuid())
  tenantId    String
  programmeId String
  name        String
  code        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  programme   Programme @relation(fields: [programmeId], references: [id])
  students    Student[]

  openElectiveEligibilities OpenElectiveEligibility[]

  @@unique([tenantId, code])
  @@index([programmeId])
}

model AcademicYear {
  id        String     @id @default(cuid())
  tenantId  String
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean    @default(false)
  createdAt DateTime   @default(now())
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batches   Batch[]
  semesters Semester[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Semester {
  id                  String               @id @default(cuid())
  tenantId            String
  academicYearId      String
  name                String
  semesterNumber      Int
  startDate           DateTime
  endDate             DateTime
  isCurrent           Boolean              @default(false)
  createdAt           DateTime             @default(now())
  examinations        Examination[]
  feeDemands          FeeDemand[]
  sections            Section[]
  academicYear        AcademicYear         @relation(fields: [academicYearId], references: [id])
  timetables          Timetable[]
  courseRegistrations CourseRegistration[]
  assessmentEvents    AssessmentEvent[]

  openElectiveOfferings OpenElectiveOffering[]

  feedbackSubmissions FeedbackSubmission[]

  @@unique([academicYearId, semesterNumber])
  @@index([tenantId])
}

model Batch {
  id             String       @id @default(cuid())
  tenantId       String
  programmeId    String
  academicYearId String
  name           String
  code           String
  maxStrength    Int?
  createdAt      DateTime     @default(now())
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  programme      Programme    @relation(fields: [programmeId], references: [id])
  sections       Section[]
  students       Student[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([programmeId])
}

model Section {
  id                  String               @id @default(cuid())
  tenantId            String
  batchId             String
  semesterId          String
  name                String
  maxStrength         Int?
  createdAt           DateTime             @default(now())
  attendance          Attendance[]
  batch               Batch                @relation(fields: [batchId], references: [id])
  semester            Semester             @relation(fields: [semesterId], references: [id])
  students            Student[]
  timetables          Timetable[]
  courseRegistrations CourseRegistration[]
  assessmentEvents    AssessmentEvent[]

  @@unique([batchId, semesterId, name])
  @@index([tenantId])
}

model Curriculum {
  id            String              @id @default(cuid())
  tenantId      String
  programmeId   String
  name          String
  version       String
  effectiveFrom DateTime
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  programme     Programme           @relation(fields: [programmeId], references: [id])
  subjects      CurriculumSubject[]

  @@unique([programmeId, version])
  @@index([tenantId])
}

model CurriculumSubject {
  id             String     @id @default(cuid())
  curriculumId   String
  courseId       String
  semesterNumber Int
  isCompulsory   Boolean    @default(true)
  credits        Int
  internalMarks  Int?
  externalMarks  Int?
  createdAt      DateTime   @default(now())
  course         Course     @relation(fields: [courseId], references: [id])
  curriculum     Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)

  @@unique([curriculumId, courseId, semesterNumber])
}

model Course {
  id                  String                    @id @default(cuid())
  tenantId            String
  departmentId        String?
  name                String
  code                String
  type                CourseType                @default(CORE)
  credits             Int                       @default(3)
  description         String?
  syllabus            String?
  isActive            Boolean                   @default(true)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  assignments         Assignment[]
  curriculumSubjects  CurriculumSubject[]
  examinations        Examination[]
  facultyAssignments  FacultyCourseAssignment[]
  timetables          Timetable[]
  courseRegistrations CourseRegistration[]
  assessmentEvents    AssessmentEvent[]

  openElectiveOfferings OpenElectiveOffering[]

  feedbackSubmissions FeedbackSubmission[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([departmentId])
}

model Student {
  id                  String                 @id @default(cuid())
  tenantId            String
  userId              String                 @unique
  enrollmentNo        String
  programmeId         String?
  batchId             String?
  sectionId           String?
  specialisationId    String?
  currentSemester     Int                    @default(1)
  status              StudentStatus          @default(ACTIVE)
  admissionDate       DateTime
  graduationDate      DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  submissions         AssignmentSubmission[]
  attendance          Attendance[]
  certificates        Certificate[]
  examResults         ExamResult[]
  feeDemands          FeeDemand[]
  payments            Payment[]
  batch               Batch?                 @relation(fields: [batchId], references: [id])
  section             Section?               @relation(fields: [sectionId], references: [id])
  specialisation      Specialisation?        @relation(fields: [specialisationId], references: [id])
  user                User                   @relation(fields: [userId], references: [id])
  documents           StudentDocument[]
  parents             StudentParent[]
  personal            StudentPersonal?
  courseRegistrations CourseRegistration[]
  achievements        Achievement[]

  openElectivePreferences OpenElectivePreference[]
  openElectiveAllocations OpenElectiveAllocation[]

  feedbackSubmissions FeedbackSubmission[]

  @@unique([tenantId, enrollmentNo])
  @@index([tenantId])
  @@index([batchId])
  @@index([sectionId])
}

model StudentPersonal {
  id               String      @id @default(cuid())
  studentId        String      @unique
  dateOfBirth      DateTime?
  gender           Gender?
  bloodGroup       BloodGroup?
  nationality      String?
  religion         String?
  category         String?
  motherTongue     String?
  permanentAddr    Json?
  localAddr        Json?
  emergencyContact Json?
  disability       Boolean     @default(false)
  disabilityDesc   String?
  updatedAt        DateTime    @updatedAt
  student          Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model StudentDocument {
  id         String       @id @default(cuid())
  studentId  String
  type       DocumentType
  fileName   String
  fileUrl    String
  fileSize   Int?
  mimeType   String?
  isVerified Boolean      @default(false)
  verifiedBy String?
  verifiedAt DateTime?
  uploadedAt DateTime     @default(now())
  student    Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model Parent {
  id           String          @id @default(cuid())
  tenantId     String
  firstName    String
  lastName     String
  email        String?
  phone        String
  occupation   String?
  annualIncome Decimal?        @db.Decimal(12, 2)
  relation     String
  createdAt    DateTime        @default(now())
  students     StudentParent[]

  @@index([tenantId])
}

model StudentParent {
  studentId String
  parentId  String
  isPrimary Boolean @default(false)
  parent    Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([studentId, parentId])
}

/// A student-claimed accomplishment: a prize, a publication, a competition
/// placing, a certification earned outside the institution.
///
/// DELIBERATELY NOT A Certificate. Certificate is INSTITUTION-ISSUED — it has a
/// template, a certificateNo, a verification QR and a revocation flag, and the
/// university stands behind it. An Achievement is STUDENT-CLAIMED: the
/// institution records it without asserting it. Conflating the two would put
/// unverified claims inside the certificate verification path, which is the one
/// place in this system that must never carry anything the university has not
/// itself issued.
///
/// TENANCY, AND WHY IT IS WEAKER HERE THAN IN PHASE 16
/// Phase 16 proves tenant ownership STRUCTURALLY with a composite foreign key
/// -- @relation(fields: [tenantId, studentId], references: [tenantId, id]) --
/// which requires @@unique([tenantId, id]) on the parent. Student does not
/// carry that key, and adding it would build a new unique index on the students
/// table: a modification to an existing table, which this phase forbids.
///
/// So tenantId is carried alongside a plain studentId foreign key, exactly as
/// FeeDemand, Payment and StudentDocument already do. Cross-tenant consistency
/// is therefore enforced by the REPOSITORY -- every query filters on both
/// columns -- rather than by the database. That is a real and stated weakening,
/// not an oversight; it can be tightened later by adding @@unique([tenantId, id])
/// to Student in a phase permitted to alter it.
model Achievement {
  id       String @id @default(cuid())
  tenantId String

  /// The student who holds it. Cascades on delete, matching StudentDocument and
  /// StudentPersonal: an achievement has no meaning without its student, and
  /// leaving orphans behind would corrupt every count on the profile portal.
  studentId String

  title String

  /// A broad, institution-neutral grouping. An enum rather than free text for
  /// the same reason DocumentType and CertificateType are enums: a portal has
  /// to group these, and free text would give one tenant "Sports", "sports" and
  /// "Sport" as three categories. OTHER plus `description` carries the tail.
  category AchievementCategory

  description String

  /// Who awarded or conferred it — a body outside this institution, which is
  /// what distinguishes an achievement from a Certificate.
  issuer String

  /// When it was achieved. Distinct from createdAt, which is when it was
  /// entered: a student records a 2023 prize in 2026, and a profile must show
  /// the former.
  achievedOn DateTime

  /// A certificate the ISSUER provided. Optional — many achievements have none.
  certificateUrl String?

  /// Supporting evidence: a results page, a publication DOI, a news link.
  evidenceUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// The portal read, exactly: one student's achievements within one tenant,
  /// newest first. Composite because this is a NEW table and can be indexed for
  /// the query it actually serves -- unlike FeeDemand and Payment, which carry
  /// separate single-column indexes this phase may not alter.
  @@index([tenantId, studentId, achievedOn])
  /// Supports the cascade on student deletion. PostgreSQL does not index a
  /// foreign key automatically, and without this a student deletion would
  /// sequentially scan this table.
  @@index([studentId])
}

/// One course offered as an open elective, in one semester, by one department.
///
/// THE MODEL PHASE 19 COULD NOT PROCEED WITHOUT.
/// `Course.type = ELECTIVE` is a permanent property of a course, and
/// `CurriculumSubject.isCompulsory = false` is programme curriculum design.
/// Neither says "this course is available to other departments THIS semester
/// with N seats", which is the entire subject of this phase.
///
/// SEATS ARE DERIVED, NEVER STORED.
/// `totalSeats` is the CAPACITY the department declared. Seats REMAINING is
/// `totalSeats - count(allocations where outcome = ALLOCATED)`, computed on
/// read. A stored remaining-count is a cache that drifts the moment two
/// allocations race, and a drifted seat count either oversubscribes a room or
/// refuses a student who should have been admitted.
model OpenElectiveOffering {
  id       String @id @default(cuid())
  tenantId String

  courseId   String
  semesterId String

  /// The department that OWNS this offering. Not derived from Course.departmentId
  /// because a course may be co-owned or transferred, and the offering's owner
  /// is who answers for its seats in the semester it was offered.
  offeringDepartmentId String

  /// The regulation that will grade it.
  ///
  /// Carried HERE because CourseRegistration.evaluationSchemeId is NOT NULL and
  /// an open elective is taken outside the student's own programme — so the
  /// student's own scheme is the wrong answer. Per the Phase 19 decision,
  /// evaluation follows the OFFERING department's scheme, and recording it on
  /// the offering is what makes that reproducible after the scheme is
  /// superseded.
  evaluationSchemeId String

  /// Capacity the department declared. Remaining seats are derived from this.
  totalSeats Int

  status OpenElectiveStatus @default(DRAFT)

  allocationStrategy ElectiveAllocationStrategy @default(FCFS)

  statusChangedAt DateTime @default(now())

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course     Course     @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  semester   Semester   @relation(fields: [semesterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  department Department @relation(fields: [offeringDepartmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy  User?      @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Composite, tenant-proving: EvaluationScheme carries @@unique([tenantId, id]),
  /// so an offering cannot cite another tenant's regulation. The same pattern
  /// CourseRegistration already uses for the same column.
  evaluationScheme EvaluationScheme @relation(fields: [tenantId, evaluationSchemeId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  eligibility OpenElectiveEligibility[]
  preferences OpenElectivePreference[]
  allocations OpenElectiveAllocation[]

  /// One offering per course per semester. A second would split its seats into
  /// two pools nobody could reconcile.
  @@unique([courseId, semesterId])
  /// Lets every child table below prove tenant ownership STRUCTURALLY through a
  /// composite foreign key, rather than by a predicate a query could forget.
  /// Available here because this is a new table; Student could not be given the
  /// same key without altering an existing one.
  @@unique([tenantId, id])
  /// The catalogue read: which electives are open, in this semester, for this
  /// tenant.
  @@index([tenantId, semesterId, status])
  @@index([offeringDepartmentId])
}

/// One positive rule about who may take an offering.
///
/// ABSENCE OF ROWS MEANS UNRESTRICTED. A row is an ALLOW rule, and multiple
/// rows are OR-ed: "open to CSE" plus "open to ECE semester 5" admits both.
/// Modelling restrictions as rows rather than as JSON on the offering is what
/// makes "which electives can THIS student see" a query rather than a scan
/// through blobs in application memory.
///
/// All three narrowing columns are nullable, and each null means "any":
/// programmeId null = any programme, specialisationId null = any branch,
/// semesterNumber null = any semester.
model OpenElectiveEligibility {
  id       String @id @default(cuid())
  tenantId String

  offeringId String

  /// Null means any programme.
  programmeId String?

  /// Null means any branch. "Branch" is Specialisation, per the Phase 19 decision.
  specialisationId String?

  /// Null means any semester. The student's currentSemester, not a Semester id.
  semesterNumber Int?

  createdAt DateTime @default(now())

  offering       OpenElectiveOffering @relation(fields: [tenantId, offeringId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)
  programme      Programme?           @relation(fields: [programmeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  specialisation Specialisation?      @relation(fields: [specialisationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Reading one offering's rules, and supporting the cascade.
  @@index([tenantId, offeringId])
  /// NOT declared unique. PostgreSQL treats NULLs as DISTINCT in a unique
  /// constraint, so (offering, null, null, null) could be inserted twice and
  /// the constraint would permit it — a guarantee that holds for some rows and
  /// not others is worse than none. Duplicate-rule prevention is the service's,
  /// and is stated there rather than implied here.
  @@index([programmeId])
  @@index([specialisationId])
}

/// One student's ranked wish for one offering.
///
/// CourseRegistration cannot express any of this: it has no rank, no notion of
/// an unfulfilled wish, and cannot hold three competing choices for one slot.
/// This table is the input to allocation; CourseRegistration is its output.
model OpenElectivePreference {
  id       String @id @default(cuid())
  tenantId String

  studentId  String
  offeringId String

  /// Denormalised from the offering.
  ///
  /// Carried here ONLY so the rank-uniqueness constraint below can be
  /// expressed — a unique index cannot reach through a relation. The service
  /// copies it from the offering and must keep the two consistent; that is a
  /// stated obligation, not an invariant the database enforces.
  semesterId String

  /// 1 is the most preferred. Ordering is ALWAYS honoured before any
  /// tie-breaking strategy.
  preferenceRank Int

  /// When the student submitted. The FCFS tie-breaker reads this, which is why
  /// it is a column rather than a reliance on createdAt semantics.
  submittedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student  Student              @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  offering OpenElectiveOffering @relation(fields: [tenantId, offeringId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  /// A student cannot rank one offering twice.
  @@unique([studentId, offeringId])
  /// A student cannot spend one rank on two offerings in the same semester.
  /// This is the constraint the denormalised semesterId exists to make
  /// expressible.
  @@unique([studentId, semesterId, preferenceRank])
  /// The allocation read: every preference for one offering, in rank order,
  /// with the FCFS tie-breaker available on the same index.
  @@index([tenantId, offeringId, preferenceRank, submittedAt])
}

/// What an allocation run concluded for one student at one offering.
///
/// AUDIT AND HISTORY ONLY. The enrolment itself is a CourseRegistration with
/// RegistrationType.OPEN_ELECTIVE — this table never becomes a second source of
/// truth about who is enrolled. It exists because CourseRegistration cannot
/// record WHICH PREFERENCE RANK was satisfied, and cannot record a student who
/// received nothing; without both, an allocation report cannot be produced and
/// a disputed outcome cannot be explained.
model OpenElectiveAllocation {
  id       String @id @default(cuid())
  tenantId String

  offeringId String
  studentId  String

  /// The rank this allocation satisfied. Recorded for ALLOCATED and
  /// NOT_ALLOCATED alike, because "you were refused at rank 1" and "you were
  /// refused at rank 4" are different answers to the same complaint.
  preferenceRank Int

  outcome ElectiveAllocationOutcome

  /// The enrolment this produced. Null exactly when outcome is NOT_ALLOCATED.
  courseRegistrationId String?

  allocatedAt DateTime @default(now())

  createdAt DateTime @default(now())

  offering           OpenElectiveOffering @relation(fields: [tenantId, offeringId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)
  student            Student              @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courseRegistration CourseRegistration?  @relation(fields: [courseRegistrationId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// One verdict per student per offering. A re-run must replace the previous
  /// verdict rather than accumulate a second one beside it.
  @@unique([offeringId, studentId])
  /// The seat count and the allocation report both read this shape.
  @@index([tenantId, offeringId, outcome])
  @@index([studentId])
  @@index([courseRegistrationId])
}

