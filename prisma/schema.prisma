  designation    String?
  qualification  String?
  specialization String?
  experience     Int?

  /// Phase 23 — "Professional Photo".
  ///
  /// A URL, not bytes. The project stores no file anywhere: StudentDocument,
  /// Certificate.pdfUrl and AssignmentSubmission.attachments all hold
  /// client-supplied locations, and no upload, R2 client or object-storage code
  /// exists in the repository. This column follows that established precedent
  /// rather than introducing a second, incompatible convention.
  ///
  /// Nullable because every faculty row that exists today has no photo, and a
  /// required column would fail to apply against live data.
  photoUrl          String?
  status            EmployeeStatus            @default(ACTIVE)
  joinDate          DateTime
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  attendance        Attendance[]
  courseAssignments FacultyCourseAssignment[]
