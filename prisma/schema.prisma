model Examination {
  id           String          @id @default(cuid())
  tenantId     String
  semesterId   String
  courseId     String
  title        String
  type         ExaminationType @default(INTERNAL)
  status       ExamStatus      @default(SCHEDULED)
  date         DateTime?
  startTime    String?
  endTime      String?
  venue        String?
  maxMarks     Int             @default(100)
  passMark     Int?
  duration     Int?
  instructions String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  results      ExamResult[]
  hallTickets  HallTicket[]
  course       Course          @relation(fields: [courseId], references: [id])
  semester     Semester        @relation(fields: [semesterId], references: [id])

  @@index([tenantId])
  @@index([semesterId])
  @@index([courseId])
}

/// PRD 17.2 "Hall-ticket generation" and 19.1 "Examination hall ticket".
///
/// THE ISSUED DOCUMENT, NOT A DERIVED VIEW
///   Eligibility is computed on demand from the enrolment and the register —
///   see lib/domain/examination/eligibility.ts — and is deliberately NOT
///   stored. A hall ticket is the opposite: it is an artefact that was ISSUED,
///   at a time, to a student, for one examination. "When was this issued" and
///   "was it issued at all" cannot be recomputed from anything, so the row is
///   the fact.
///
/// WHY NOT Certificate
///   Certificate requires a CertificateTemplate and carries no examination.
///   A hall ticket must cite the examination whose venue, date and time it
///   prints, and must be unique per (examination, student). Expressing that
///   through Certificate would mean an examinationId buried in an unqueryable
///   Json column with no foreign key and no uniqueness — strictly worse than
///   the four columns below.
///
/// ONE TICKET PER STUDENT PER EXAMINATION
///   @@unique([examinationId, studentId]) is that rule, enforced by the
///   database rather than by a service check a second code path could miss. It
///   also makes generation idempotent: re-running it for a cohort updates the
///   rows that exist instead of issuing duplicates.
model HallTicket {
  id            String @id @default(cuid())
  tenantId      String
  examinationId String
  studentId     String

  /// Human-readable identity printed on the ticket. Unique within the tenant.
  ///
  /// Derived from the examination and the student's enrolment number rather
  /// than from the IdSequence engine: that engine refuses to issue unless a
  /// sequence row has been configured for the entity, so routing hall tickets
  /// through it would make generation fail on every tenant that had not set one
  /// up. No parallel counter is introduced — the value is deterministic.
  ticketNo String

  /// Seat allocation. Nullable: PRD 17.2 lists seat allocation as its own
  /// concern, and a ticket is valid without one.
  seatNo String?

  issuedAt   DateTime @default(now())
  /// The User who generated it. Nullable so deleting an account never deletes
  /// the evidence that a ticket was issued.
  issuedById String?

  examination Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id])

  @@unique([examinationId, studentId])
  @@unique([tenantId, ticketNo])
  /// No two candidates in the same examination hold the same seat.
  ///
  /// This is the whole of what "no conflicting seats" means, and it is enforced
  /// by the database rather than by the allocator that happens to assign them.
  /// A partial index: PostgreSQL treats NULLs as distinct, so any number of
  /// tickets may sit unallocated without colliding with each other.
  @@unique([examinationId, seatNo])
  @@index([tenantId])
  @@index([studentId])
  @@index([examinationId])
}

model ExamResult {
  id            String    @id @default(cuid())
  examinationId String
  studentId     String
  marksObtained Decimal?  @db.Decimal(6, 2)
  grade         String?
  gradePoint    Decimal?  @db.Decimal(4, 2)
  isPassed      Boolean?
  isAbsent      Boolean   @default(false)
  remarks       String?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  examination Examination @relation(fields: [examinationId], references: [id])
  student     Student     @relation(fields: [studentId], references: [id])

  @@unique([examinationId, studentId])
  @@index([studentId])
}

/// Phase 16 — Component 1.
///
/// A versioned, tenant-owned grading vocabulary: the rule that turns a
/// percentage into a grade letter and a grade point.
///
/// OWNERSHIP    : Tenant. One tenant may run several concurrent scales (an
///                undergraduate 10-point scale and a doctoral pass/fail scale)
///                distinguished by `code`.
/// LIFECYCLE    : DRAFT -> ACTIVE -> ARCHIVED. A scale is freely editable only
///                while DRAFT. Activation freezes the row and every GradeBand
///                beneath it; a regulation change is a NEW version, never an
///                edit, so a grade card issued in 2019 can always be recomputed
///                from the exact bands that produced it.
/// VERSIONING   : (tenantId, code) names the scale; `version` names the
///                revision. Result rows reference a specific GradeScale.id —
///                that is, one immutable revision — which is what makes a
///                historical result reproducible.
/// SOURCE OF    : The mapping percentage -> grade -> gradePoint, and nothing
/// TRUTH          else. It owns no marks, no results and no weightage.
model GradeScale {
  id String @id @default(cuid())

  tenantId String

  /// Stable identifier of the scale ACROSS versions, e.g. "UG-10-POINT".
  /// Two rows sharing a code are two revisions of one regulation.
  code String

  name        String
  description String?

  /// Revision number within (tenantId, code), starting at 1. Never reused:
  /// a superseded version keeps its number forever.
  version Int @default(1)

  status GradeScaleStatus @default(DRAFT)

  /// ABSOLUTE maps a percentage directly through the bands. RELATIVE ranks the
  /// cohort first and assigns bands by position. The enum is the branch the
  /// engine dispatches on, so it is a column, never JSON.
  method GradeCalculationMethod @default(ABSOLUTE)

  /// Parameters for `method`, read only AFTER the engine has branched on it —
  /// the one sanctioned use of JSON in this design.
  ///
  /// ABSOLUTE : must be null. The bands are the entire rule.
  /// RELATIVE : { "cohortScope": "SECTION" | "BATCH" | "COURSE",
  ///              "minCohortSize": number,
  ///              "distribution": [{ "grade": string, "topPercent": number }],
  ///              "fallbackToAbsolute": boolean }
  ///
  /// Nothing here is ever filtered or aggregated on, which is precisely why it
  /// is not modelled as columns. The shape is enforced by Zod at the service
  /// boundary, not by the database.
  methodConfig Json?

  /// The scale's ceiling — 10.00 on an Indian scale, 4.00 on a US one. Stored
  /// because SGPA/CGPA must be normalisable across scales when a student
  /// transfers, and because no band may declare a gradePoint above it.
  maxGradePoint Decimal @db.Decimal(4, 2)

  /// The revision that replaced this one. Null on the newest revision and on a
  /// version retired without a successor, so it is NOT derivable from `status`.
  supersededById String?

  activatedAt   DateTime?
  activatedById String?
  archivedAt    DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Tenancy anchor. Cascade matches the treatment of every other tenant-owned
  /// configuration root (Role, Campus, AcademicYear, IdSequence): removing a
  /// university removes its regulations.
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Governance attribution: who drafted this revision, and who authorised it.
  /// Both are nullable with SetNull because DELETE /api/users/[id] is a hard
  /// delete that a Restrict here would start rejecting — an existing endpoint
  /// this component must not alter. The permanent, actor-preserving record is
  /// AuditLog, whose userId deliberately carries no foreign key and therefore
  /// survives the user row.
  createdBy   User? @relation("GradeScaleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  activatedBy User? @relation("GradeScaleActivatedBy", fields: [activatedById], references: [id], onDelete: SetNull)

  /// Version chain, tenant-scoped by construction: the composite key proves a
  /// revision can only ever be superseded by a revision of the SAME tenant.
  ///
  /// NoAction rather than Restrict is deliberate and load-bearing. PostgreSQL
  /// checks NO ACTION at end-of-statement and RESTRICT immediately, so under
  /// NoAction a tenant-level cascade deletes an entire version chain in one
  /// statement, while Restrict would abort it on the first still-referenced
  /// ancestor.
  supersededBy GradeScale?  @relation("GradeScaleVersion", fields: [tenantId, supersededById], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  supersedes   GradeScale[] @relation("GradeScaleVersion")

  bands             GradeBand[]
  evaluationSchemes EvaluationScheme[]

  /// One revision number per named scale per tenant.
  @@unique([tenantId, code, version])
  /// Not a uniqueness rule — `id` is already unique. This is the TARGET of the
  /// composite foreign keys above and in GradeBand, which is what makes a
  /// cross-tenant reference structurally impossible rather than merely avoided.
  @@unique([tenantId, id])
  /// Serves the only two collection reads: "the active scales of this tenant"
  /// and the status-filtered configuration list.
  @@index([tenantId, status])
  /// Serves the version-chain walk and the NO ACTION referential check, so
  /// neither degrades to a sequential scan as the table accumulates revisions
  /// across hundreds of tenants.
  @@index([tenantId, supersededById])
}

/// Phase 16 — Component 1.
///
/// One row of a GradeScale: a percentage interval and the grade it awards.
///
/// OWNERSHIP    : GradeScale. A band has no meaning or lifecycle of its own and
///                is deleted with its scale.
/// LIFECYCLE    : Mutable only while the parent scale is DRAFT; frozen from
///                activation onward. Bands are never edited in place on an
///                ACTIVE scale — the scale is cloned to a new version instead.
/// SOURCE OF    : The interval -> grade -> gradePoint mapping, plus whether the
/// TRUTH          band clears the course and whether it enters the GPA. Credits
///                earned are DERIVED (isPass ? registeredCredits : 0) and are
///                deliberately not stored here.
/// INTERVALS    : minPercent and maxPercent are BOTH inclusive. The bands of an
///                ACTIVE scale must tile [0.00, 100.00] exactly, each band
///                starting one step (0.01) above the previous band's ceiling.
///                Decimal(5,2) is exact base-10, so this tiling has no gaps and
///                no floating-point ambiguity — unlike a float interval, where
///                a mark landing on a boundary could fall through every band.
///                Totals are rounded to 2dp before lookup.
model GradeBand {
  id String @id @default(cuid())

  /// Carried so the composite foreign key below can prove this band and its
  /// scale belong to the same tenant. It is NOT a second ownership record: the
  /// FK constrains it to equal GradeScale.tenantId, so the two cannot diverge.
  tenantId     String
  gradeScaleId String

  /// The awarded symbol — "O", "A+", "P", "F", "W". Free text, because the
  /// vocabulary is the university's and an enum here would make every new
  /// grade letter a migration.
  grade String

  /// Human-readable expansion, e.g. "Outstanding".
  label String?

  minPercent Decimal @db.Decimal(5, 2)
  maxPercent Decimal @db.Decimal(5, 2)

  /// Points contributed per credit. Bounded above by GradeScale.maxGradePoint.
  gradePoint Decimal @db.Decimal(4, 2)

  /// Does this band clear the course? Drives backlog detection and credit
  /// award. False for "F" and "W".
  isPass Boolean @default(true)

  /// Does this band enter the SGPA calculation? Independent of isPass, and the
  /// two together express every real regulation without a third column:
  ///   O/A/B  -> isPass true,  countsForGpa true   (ordinary graded pass)
  ///   P, T   -> isPass true,  countsForGpa false  (pass-only, transfer credit)
  ///   F (US) -> isPass false, countsForGpa true   (zero points, still in the
  ///                                                credit denominator)
  ///   F (IN) -> isPass false, countsForGpa false  (excluded until cleared)
  ///   W      -> isPass false, countsForGpa false  (withdrawn)
  countsForGpa Boolean @default(true)

  /// Presentation order, 1 = highest band. Stored rather than derived from
  /// minPercent so a scale may list non-percentage bands (W, I) in a chosen
  /// position without implying an interval ordering.
  sequence Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Composite parent key: a band can only attach to a scale of its own tenant,
  /// enforced by the database rather than by application discipline. Cascade
  /// because a band cannot outlive its scale.
  gradeScale GradeScale @relation(fields: [tenantId, gradeScaleId], references: [tenantId, id], onDelete: Cascade)

  /// One row per grade symbol per scale. Both columns are NOT NULL, so
  /// PostgreSQL enforces this completely — unlike the nullable-column unique
  /// constraints recorded as TD-001 and TD-003, where NULL-distinctness leaves
  /// duplicates storable.
  @@unique([gradeScaleId, grade])
  /// Deterministic ordering. Without it two bands could share a position and a
  /// grade card would order them differently between requests.
  @@unique([gradeScaleId, sequence])
  /// Composite-FK target, so a future CourseResult can record the exact band it
  /// applied under the same tenant-proving constraint. No index is declared on
  /// (tenantId, gradeScaleId): the unique index above leads with gradeScaleId
  /// and the planner uses it for both the join and the cascade check, on a table
  /// bounded at roughly a dozen rows per scale.
  @@unique([tenantId, id])
}

/// Phase 16 — Component 2.
///
/// A versioned, tenant-owned ACADEMIC REGULATION: the named rulebook under
/// which a course is evaluated. It answers "how are numbers computed and
/// rounded, and against which grading vocabulary" — and nothing else.
///
/// OWNERSHIP    : Tenant. A university runs many regulations concurrently
///                (B.Tech 2023, MBA 2024, MBBS 2021), distinguished by `code`.
/// LIFECYCLE    : DRAFT -> ACTIVE -> ARCHIVED, identical in shape to
///                GradeScale. Editable only while DRAFT. Activation freezes the
///                row; a regulation change is a NEW version, never an edit, so a
///                result computed in 2019 can be recomputed from the exact
///                policy that produced it.
/// VERSIONING   : (tenantId, code) names the regulation; `version` names the
///                revision. Result rows will reference a specific
///                EvaluationScheme.id — one immutable revision — which is what
///                makes a historical SGPA reproducible.
/// SOURCE OF    : Computation policy only — which grade scale applies, how
/// TRUTH          repeated attempts are reconciled, and how marks and GPA are
///                rounded. It owns NO thresholds (those are EvaluationRule),
///                NO weightage (that is EvaluationComponent) and NO binding to
///                courses (that is the scheme-assignment component).
/// BOUNDARY     : Scheme = how a number is computed. Rule = what threshold that
///                number must clear. Keeping the two apart is what stops a
///                pass mark being expressible in two places at once.
model EvaluationScheme {
  id String @id @default(cuid())

  tenantId String

  /// Stable identifier of the regulation ACROSS versions, e.g. "BTECH-R2023".
  /// Two rows sharing a code are two revisions of one rulebook.
  code String

  name        String
  description String?

  /// Revision number within (tenantId, code), starting at 1. Never reused: a
  /// superseded revision keeps its number forever.
  version Int @default(1)

  status EvaluationSchemeStatus @default(DRAFT)

  /// The grading vocabulary this regulation grades against — a specific,
  /// immutable GradeScale REVISION, not a scale family. Required: a regulation
  /// that cannot award a grade is not a regulation, and making it nullable
  /// would force a "not determinable" branch through the entire engine.
  gradeScaleId String

  /// How a course sat more than once is reconciled when CGPA is computed.
  /// A column and not JSON because the engine branches on it and because
  /// "which regulations use BEST_ATTEMPT" is a question an examination
  /// controller genuinely asks.
  attemptPolicy AttemptPolicy @default(LATEST_ATTEMPT)

  /// Rounding is versioned policy, not an implementation detail — it is the
  /// arithmetic universities are challenged on, and a student who was awarded
  /// 39.5 -> 40 must still be seen to have passed a decade later.
  ///
  /// Marks and GPA are rounded independently and deliberately: an institution
  /// may round marks HALF_UP in the student's favour while rounding GPA
  /// HALF_EVEN, which removes the systematic upward bias HALF_UP introduces
  /// across a cohort average.
  marksRounding  RoundingMode @default(HALF_UP)
  marksPrecision Int          @default(2)
  gpaRounding    RoundingMode @default(HALF_UP)
  gpaPrecision   Int          @default(2)

  /// The revision that replaced this one. Null on the newest revision and on a
  /// revision retired without a successor, so it is NOT derivable from `status`.
  supersededById String?

  activatedAt   DateTime?
  activatedById String?
  archivedAt    DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Tenancy anchor. Cascade matches GradeScale and every other tenant-owned
  /// configuration root: removing a university removes its regulations.
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Composite key, so a regulation can only ever cite a grade scale of its own
  /// tenant — proven by the database, not by application discipline.
  ///
  /// NoAction rather than Restrict for the reason established in C1: PostgreSQL
  /// checks NO ACTION at end-of-statement and RESTRICT immediately. NoAction
  /// still refuses a standalone delete of a cited GradeScale (protecting
  /// reproducibility), while allowing a tenant-level cascade — which drops the
  /// scheme and the scale in the same statement — to succeed. Restrict would
  /// abort that cascade depending on the order rows happen to be removed in.
  gradeScale GradeScale @relation(fields: [tenantId, gradeScaleId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  /// Governance attribution: who drafted this revision, and who authorised it.
  /// Nullable with SetNull for the reason established in C1 — DELETE
  /// /api/users/[id] is a hard delete, and Restrict here would begin rejecting
  /// it. The permanent, actor-preserving record is AuditLog.
  createdBy   User? @relation("EvaluationSchemeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  activatedBy User? @relation("EvaluationSchemeActivatedBy", fields: [activatedById], references: [id], onDelete: SetNull)

  /// Version chain, tenant-scoped by construction.
  supersededBy EvaluationScheme?  @relation("EvaluationSchemeVersion", fields: [tenantId, supersededById], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  supersedes   EvaluationScheme[] @relation("EvaluationSchemeVersion")

  components EvaluationComponent[]

  /// Policy transforms this regulation applies. Frozen with it on activation,
  /// which is what keeps a historical result reproducible.
  rules EvaluationRule[]

  /// Minimum thresholds this regulation requires beyond a passing grade.
  passingCriteria     PassingCriterion[]
  courseRegistrations CourseRegistration[]

  /// One revision number per named regulation per tenant. This REPLACES the
  /// previous @@unique([tenantId, code]), which made versioning impossible: a
  /// second revision would have collided with the first on the same code.
  openElectiveOfferings OpenElectiveOffering[]

  @@unique([tenantId, code, version])
  /// Not a uniqueness rule — `id` is already unique. This is the TARGET of the
  /// self-relation above and of every composite foreign key that later cites a
  /// regulation revision, which is what makes a cross-tenant reference
  /// structurally impossible.
  @@unique([tenantId, id])
  /// Serves the configuration list and the "active regulations" read.
  @@index([tenantId, status])
  /// Serves the version-chain walk and the NO ACTION referential check.
  @@index([tenantId, supersededById])
  /// Serves the composite foreign key's referencing side and the question an
  /// administrator must answer before archiving a scale: "which regulations
  /// still cite this grade scale revision?"
  @@index([tenantId, gradeScaleId])
}

/// Phase 16 — Component 3.
///
/// One node of a regulation's assessment structure: an ordered tree whose
/// leaves are the things a mark is entered against, and whose branches roll
/// their children up by weight.
///
/// This tree IS the configurability requirement. "Internal 30 / Theory 70",
/// "ST1 / ST2 / PUT / Assignment / Attendance / Practical / Viva" and
/// "Clinical / Logbook / Viva" are the same model with different rows — no
/// backend change, no migration, no enum edit.
///
/// OWNERSHIP    : EvaluationScheme. A component has no lifecycle of its own and
///                is frozen, versioned and archived with its regulation.
/// LIFECYCLE    : Mutable only while the owning scheme is DRAFT. Activation
///                freezes the whole tree.
/// SOURCE OF    : The structure, the weights and the aggregation rules. It owns
/// TRUTH          no marks and no results.
/// VALIDATION   : Per-node rules are checked on write. Whole-tree rules —
///                sibling weights totalling 100, leaf/branch coherence, absence
///                of cycles — are checked at ACTIVATION, not on insert, because
///                a draft is legitimately incomplete while it is being built.
model EvaluationComponent {
  id String @id @default(cuid())

  /// Carried so the composite foreign keys below can prove this node, its
  /// scheme and its parent all belong to one tenant. Constrained by those keys
  /// to equal the scheme's tenantId, so it is not a second ownership record.
  tenantId String

  schemeId          String
  parentComponentId String?

  /// Stable identifier within the scheme — "ST1", "THEORY", "LOGBOOK". Free
  /// text, because the vocabulary is the university's; an enum here would make
  /// every new component kind a migration, which is exactly what this phase
  /// exists to avoid.
  code String

  name        String
  description String?

  /// Classification, never identity. `type` exists so reports and the
  /// specification's internal/external upload routes can filter; what a
  /// component IS, is its code. A medical college's logbook is
  /// code "LOGBOOK", type CUSTOM — no schema change.
  type EvaluationComponentType

  /// Where this node's marks come from. This single column is what makes
  /// "Attendance Marks" and "Faculty Evaluation" configurable rather than
  /// coded: a node whose source is ATTENDANCE_DERIVED is never typed in, it is
  /// computed from attendance by the engine using ruleConfig.
  sourceType ComponentSource @default(MANUAL_ENTRY)

  /// The raw scale a mark is entered on — ST1 out of 20.
  maxMarks Decimal @db.Decimal(6, 2)

  /// The percentage this node contributes to its PARENT's total, or to the
  /// course total when it is a root.
  ///
  /// maxMarks and weightage are NOT two names for one number, which is what the
  /// superseded draft made them. A quiz may be marked out of 10 and be worth 5%
  /// of the course; separating the scale from the contribution is what lets one
  /// model serve a university that marks internals out of 30 worth 30% and one
  /// that marks them out of 50 worth 20%.
  weightage Decimal @db.Decimal(5, 2)

  /// How this node's own repeated sessions combine — three sittings of ST1
  /// reduced to one figure. Meaningful on a LEAF only.
  aggregation ComponentAggregation?

  /// How this node's CHILDREN combine into its own figure. Meaningful on a
  /// BRANCH only.
  ///
  /// The superseded draft had a single `ruleType` covering both, which
  /// conflated two operators applied at two different levels of the tree and
  /// left "best 2 of 3 tests" indistinguishable from "weighted sum of internal
  /// and external".
  rollup ComponentRollup?

  /// Parameters for `aggregation` and `sourceType`, read only AFTER the engine
  /// has branched on them — the one sanctioned use of JSON here.
  ///
  ///   { "count": number }            — BEST_N keeps N; DROP_LOWEST_N drops N.
  ///   { "attendanceBands": [ { "minPercent": number, "marks": number } ] }
  ///                                  — ATTENDANCE_DERIVED band table.
  ///
  /// Nothing in it is ever filtered or aggregated on, which is precisely why it
  /// is not columns. The shape is enforced by Zod at the service boundary.
  ruleConfig Json?

  /// Presentation order among siblings.
  sequence Int

  /// Whether a missing mark blocks computation (mandatory) or is treated as not
  /// attempted (optional). The engine branches on it, so it is a column.
  isMandatory Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Owning regulation, tenant-proving. Cascade because a component cannot
  /// outlive its scheme.
  scheme EvaluationScheme @relation(fields: [tenantId, schemeId], references: [tenantId, id], onDelete: Cascade)

  /// Parent node — a THREE-column composite key, and the extra column is the
  /// point of it. Keying on (tenantId, schemeId, parentComponentId) makes it
  /// structurally impossible for a node to be parented to a component of a
  /// DIFFERENT REGULATION, not merely of a different tenant. The superseded
  /// draft keyed on the bare id, so one scheme's tree could silently graft
  /// itself onto another's.
  ///
  /// NoAction rather than Cascade, for the reason established in C1 and C2:
  /// PostgreSQL defers NO ACTION to end-of-statement, so deleting a scheme —
  /// or a whole subtree in one statement — succeeds, while a stray single-row
  /// delete that would orphan children is still refused. Subtree deletion is
  /// performed deliberately by the service, in one bulk statement, so the audit
  /// entry records exactly which nodes went; a database cascade would remove
  /// rows the audit log never sees.
  parent   EvaluationComponent?  @relation("EvaluationComponentTree", fields: [tenantId, schemeId, parentComponentId], references: [tenantId, schemeId, id], onDelete: NoAction, onUpdate: NoAction)
  children EvaluationComponent[] @relation("EvaluationComponentTree")
  /// Rules that adjust this component's computed value.
  rules    EvaluationRule[]

  /// Minimum thresholds this component must independently meet.
  passingCriteria  PassingCriterion[]
  assessmentEvents AssessmentEvent[]

  /// One code per scheme.
  @@unique([schemeId, code])
  /// One position per sibling group.
  ///
  /// NOTE — parentComponentId is nullable and PostgreSQL treats NULL as
  /// distinct, so this constrains non-root siblings completely but leaves ROOT
  /// components able to share a sequence. That is the TD-001 / TD-003 shape,
  /// and here it is known and compensated rather than accidental: the service
  /// enforces root ordering, and list order is (sequence, code) — total
  /// regardless, because code is unique per scheme. A partial unique index is
  /// available as migration hardening.
  @@unique([schemeId, parentComponentId, sequence])
  /// Composite-FK target for a future ComponentMark, which needs the tenant but
  /// not the scheme.
  @@unique([tenantId, id])
  /// Composite-FK target for the parent relation above.
  @@unique([tenantId, schemeId, id])
  /// The module's only hot query: load one scheme's entire tree in a single
  /// statement. Every tree operation is then performed in memory.
  @@index([tenantId, schemeId])
  /// Serves the parent relation's referencing side and the children lookup.
  @@index([tenantId, parentComponentId])
}

/// Phase 16 — Component 4.
///
/// A POLICY TRANSFORM applied at a named stage of the calculation pipeline.
///
/// Read the boundary carefully, because it is the whole design:
///
///   EvaluationComponent answers "what is assessed, and how do its own numbers
///   reduce to one figure" — structure, weight, order, and the intrinsic
///   aggregation of a component's own sessions.
///
///   EvaluationRule answers "what does the regulation then DO to that figure" —
///   scale it, cap it, add a bonus, award grace, moderate it against the
///   cohort, or run a bespoke formula.
///
///   PassingCriteria (a later component) answers "what threshold must the
///   result clear". No rule here owns a threshold.
///
///   GradeScale answers "how does a percentage become a grade".
///
/// A rule is therefore a pure numeric transformation: numbers in, one number
/// out. It never reads a threshold, never assigns a grade, and never changes
/// the shape of the tree.
///
/// OWNERSHIP    : EvaluationScheme. Rules are frozen, versioned and archived
///                with the regulation, exactly like components — which is what
///                makes a historical result reproducible: the rules that
///                produced it cannot have changed.
/// LIFECYCLE    : Mutable only while the owning scheme is DRAFT.
/// PIPELINE     : (phase, sequence) is the execution order. Rules at one phase
///                run in sequence, each consuming the previous one's output, so
///                "add grace, then cap at the maximum" is two ordered rows
///                rather than a special combined operator.
model EvaluationRule {
  id String @id @default(cuid())

  /// Carried so the composite foreign keys below can prove the rule, its
  /// scheme and its component all belong to one tenant.
  tenantId String

  schemeId String

  /// The component whose value this rule transforms, or NULL when the rule
  /// transforms the COURSE-LEVEL figure after every component has rolled up.
  ///
  /// The null is meaningful, not absent data: a curve applies to the course
  /// result and to no single component, and modelling that as a second table
  /// would duplicate every column to express one distinction.
  componentId String?

  /// Stable handle, unique within the scheme — "GRACE5", "MODERATE-2024".
  ///
  /// Not decoration. A computed result must be explainable years later, so the
  /// computation trace records which rules touched a mark; a trace citing
  /// cuids explains nothing to a registrar reading it.
  code String

  name        String
  description String?

  /// Which stage of the pipeline this rule runs at.
  phase RulePhase

  /// What the rule does. The engine dispatches on this, so it is a column.
  operation RuleOperation

  /// Order within (component, phase). Rules compose in this order.
  sequence Int

  /// Parameters for `operation`, read only AFTER the engine has dispatched on
  /// it — the sanctioned use of JSON.
  ///
  ///   ADD_CONSTANT    { "amount": number }
  ///   ADD_PERCENTAGE  { "percent": number }
  ///   SCALE           { "factor": number }
  ///   CAP / FLOOR     { "limit": number }
  ///   GRACE           { "maxAward": number }
  ///   MODERATION      { "targetMean": number, "targetStdDev": number }
  ///   CURVE           { "distribution": [{ "grade": string, "topPercent": number }] }
  ///   CUSTOM_FORMULA  { "expression": <restricted AST> }
  ///
  /// None of it is ever filtered or aggregated on, which is exactly why it is
  /// not columns. Shape is enforced per operation by Zod at the service
  /// boundary. CUSTOM_FORMULA carries a restricted, whitelisted expression tree
  /// — never a source string, because nothing in this system will ever eval
  /// tenant-supplied text.
  config Json?

  /// When the rule applies. NULL means unconditionally.
  ///
  /// This single column is what makes conditional policy expressible without a
  /// redesign: grace marks are by definition conditional, and "a bonus only for
  /// students above 90% attendance" is a predicate, not a new operator. Stored
  /// as a restricted predicate tree for the same reason as `config`.
  condition Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Owning regulation, tenant-proving. Cascade because a rule cannot outlive
  /// the regulation that declares it.
  scheme EvaluationScheme @relation(fields: [tenantId, schemeId], references: [tenantId, id], onDelete: Cascade)

  /// Target component — a THREE-column key, so a rule can only ever target a
  /// component of its OWN regulation and tenant. Reuses the
  /// @@unique([tenantId, schemeId, id]) that C3 declared for its parent
  /// relation.
  ///
  /// Cascade rather than NoAction, and this is the one place in Phase 16 where
  /// that is the right answer: C3's component removal deletes a whole subtree
  /// in a single bulk statement, and NoAction would refuse that statement the
  /// moment any doomed component carried a rule. Cascade keeps the shipped
  /// deletion path working untouched.
  component EvaluationComponent? @relation(fields: [tenantId, schemeId, componentId], references: [tenantId, schemeId, id], onDelete: Cascade)

  /// One handle per regulation. Also the index PostgreSQL uses to find a
  /// scheme's rules, since it leads with schemeId.
  @@unique([schemeId, code])
  /// One rule per position in a pipeline stage.
  ///
  /// NOTE — componentId is nullable and PostgreSQL treats NULL as distinct, so
  /// this constrains component-scoped rules completely but leaves COURSE-level
  /// rules able to share a position. Same known-and-compensated shape as C3:
  /// the service enforces course-level ordering, and execution order is
  /// (sequence, code) — total regardless, because code is unique per scheme.
  @@unique([schemeId, componentId, phase, sequence])
  /// Composite-FK target for the computation trace that will record which rule
  /// produced which adjustment.
  @@unique([tenantId, id])
}

/// Phase 16 — Component 5.
///
/// A MINIMUM THRESHOLD a student must meet, beyond simply scoring well enough
/// to be awarded a passing grade.
///
/// The boundary, stated precisely because this is the model most at risk of
/// duplicating another:
///
///   GradeBand.isPass (C1) decides whether the COURSE TOTAL is a pass. The
///   lowest passing band IS the overall pass mark; nothing here restates it.
///
///   PassingCriterion adds the constraints a total cannot express — a minimum
///   in one component, a minimum attendance, a minimum credit count. These can
///   only ever turn a pass into a failure, never the reverse.
///
///   EvaluationRule (C4) transforms numbers. It never reads a threshold. A
///   GRACE rule is the one operation that consults one, and it is handed the
///   threshold by the engine rather than owning it.
///
/// The final outcome is therefore: the grade band decides the grade, and every
/// criterion must additionally hold. One authority per question.
///
/// OWNERSHIP    : EvaluationScheme. Criteria are frozen, versioned and archived
///                with the regulation, so a historical pass/fail decision stays
///                reproducible.
/// LIFECYCLE    : Mutable only while the owning scheme is DRAFT.
/// EVALUATION   : Criteria form a CONJUNCTION — every one must hold. There is
///                deliberately no ordering column: unlike a rule pipeline,
///                where sequence changes the arithmetic, evaluating a
///                conjunction in a different order cannot change its result.
model PassingCriterion {
  id String @id @default(cuid())

  /// Carried so the composite foreign keys below can prove the criterion, its
  /// scheme and its component all belong to one tenant.
  tenantId String

  schemeId String

  /// The component this threshold applies to. Required when metric is
  /// COMPONENT_SCORE, and NULL for every other metric — attendance and credits
  /// are properties of the student in the course or the semester, not of one
  /// component.
  ///
  /// A meaningful null, not absent data: it is what distinguishes
  /// "theory must reach 21" from "attendance must reach 75%".
  componentId String?

  /// Stable handle, unique within the scheme — "MIN-THEORY", "ATT-75".
  ///
  /// A failed result must state WHICH requirement was missed, years later, to a
  /// registrar who will not accept a cuid as an explanation.
  code String

  name        String
  description String?

  /// What is measured. Determines both the quantity and the scope at which the
  /// engine evaluates it — course-scoped or semester-scoped — so no separate
  /// scope column exists to fall out of step with it.
  metric PassingMetric

  /// The minimum that must be reached. Decimal(6,2) matches the marks columns
  /// in C3 and is exact base-10, so a threshold of 21.00 is compared without
  /// binary rounding error.
  threshold Decimal @db.Decimal(6, 2)

  /// How `threshold` should be read.
  ///
  /// Not redundant with `metric`: a component minimum is genuinely expressible
  /// either way — "21 out of 70" and "30%" are both real regulations — and the
  /// two diverge the moment a later scheme version rescales the component. The
  /// author's intent is stored rather than silently converted. The service
  /// rejects an incoherent pairing, such as CREDITS on an attendance metric.
  unit ThresholdUnit

  /// What missing this threshold does to the student.
  ///
  /// Justified by a materially different consequence, not by symmetry: a
  /// failure carries a backlog the student may clear by re-sitting, while
  /// ineligibility bars them from sitting at all. Attendance shortfall is
  /// almost always the latter, and some regulations treat an internal-marks
  /// shortfall the same way — which is exactly why this cannot be derived from
  /// `metric` and must be declared.
  failureOutcome CriterionOutcome

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Owning regulation, tenant-proving. Cascade because a criterion cannot
  /// outlive the regulation that declares it.
  scheme EvaluationScheme @relation(fields: [tenantId, schemeId], references: [tenantId, id], onDelete: Cascade)

  /// Target component — a THREE-column key, so a criterion can only ever
  /// constrain a component of its OWN regulation and tenant. Cascade for the
  /// same reason as C4: C3 removes a subtree in one bulk statement, and
  /// NoAction would refuse that statement the moment a doomed component carried
  /// a criterion.
  component EvaluationComponent? @relation(fields: [tenantId, schemeId, componentId], references: [tenantId, schemeId, id], onDelete: Cascade)

  /// One handle per regulation. Also the index PostgreSQL uses to load a
  /// scheme's criteria, since it leads with schemeId — which is why no separate
  /// [tenantId, schemeId] index is declared.
  @@unique([schemeId, code])
  /// Composite-FK target for the future result record that will name the
  /// criterion a student missed.
  @@unique([tenantId, id])
  /// Serves the component cascade. Without it, deleting a component during
  /// draft editing degrades to a sequential scan of every tenant's criteria.
  /// Declared for that reason alone — the engine itself never queries by
  /// component, because it loads a scheme's whole criterion set in one
  /// statement and indexes it in memory.
  @@index([schemeId, componentId])
}

/// Phase 16 — Component 5.5.
///
/// The immutable academic contract between a student and a course.
///
/// This is NOT a student-course mapping. It is the record every downstream
/// engine depends on — internal assessment, external assessment, result
/// calculation, transcript, promotion, backlog tracking, improvement,
/// revaluation and degree audit all resolve "who was officially enrolled in
/// what, under which regulation, on which attempt" from here and from nowhere
/// else.
///
/// WHY IT EXISTS
///   Before this model, a roster could only be derived from Student.sectionId.
///   That column is a single nullable FK, and Section is unique on
///   [batchId, semesterId, name] — so a section belongs to exactly one
///   semester and the student's value is OVERWRITTEN when they advance. The
///   derivation returns the right answer today and the wrong one next term,
///   and the historical roster is destroyed rather than merely inconvenient.
///   Student.sectionId must never again be used to derive an academic roster.
///
/// SNAPSHOTS
///   Four academic facts are copied here at registration and never change:
///   credits, the governing evaluation scheme, the programme, and the attempt
///   number. Each is copied because its source is MUTABLE and the historical
///   value is otherwise unrecoverable — Course.credits can be edited,
///   Student.programmeId is overwritten on transfer.
///
///   Deliberately NOT snapshotted: the grade scale, because EvaluationScheme is
///   immutable once ACTIVE and already pins gradeScaleId to one revision — a
///   second copy could disagree with it. Course code and title are likewise not
///   copied: they are presentation facts a transcript will snapshot when it
///   renders, not calculation inputs.
///
/// LIFECYCLE
///   REGISTERED → CONFIRMED → COMPLETED, with WITHDRAWN, DROPPED and CANCELLED
///   as exits. A registration is NEVER physically deleted: destroying one
///   destroys the historical roster this model exists to preserve.
model CourseRegistration {
  id String @id @default(cuid())

  /// Tenancy anchor. Also the leading column of the roster index, so a
  /// tenant's registrations are contiguous — which is what makes partitioning
  /// by tenant possible later without redesign.
  tenantId String

  studentId  String
  courseId   String
  semesterId String

  /// The teaching group, when one is defined.
  ///
  /// Nullable because an open elective drawn from several batches has no single
  /// Section — Section is keyed on batch, not on course. The roster is
  /// therefore (courseId, semesterId); this only narrows it.
  ///
  /// Unlike the four snapshots, this is MUTABLE: a student may be moved between
  /// teaching groups mid-term without their enrolment changing.
  sectionId String?

  /// SNAPSHOT — the programme this course was taken under.
  ///
  /// Student.programmeId is mutable and overwritten when a student transfers,
  /// exactly as sectionId is. Degree audit must know which programme a credit
  /// was earned toward, and after a transfer that is unrecoverable from the
  /// student row. Nullable because Student.programmeId is.
  programmeId String?

  /// SNAPSHOT — the regulation governing this enrolment.
  ///
  /// Pins one immutable EvaluationScheme REVISION, which is what makes a result
  /// computed years ago reproducible: the components, rules, passing criteria
  /// and grade scale that produced it are all reachable from here and none of
  /// them can have changed.
  evaluationSchemeId String

  /// SNAPSHOT — credits this enrolment carries toward the degree.
  ///
  /// Copied from Course.credits, which is mutable. Decimal rather than Int:
  /// SGPA weights by credits and the phase computes in exact decimals, and a
  /// half-credit course becomes expressible without a migration on what will be
  /// one of the largest tables in the system.
  credits Decimal @db.Decimal(4, 2)

  /// Why this enrolment exists. The engine branches on it — an audit carries no
  /// credit, a backlog and an improvement are reconciled differently under the
  /// scheme's attempt policy — so it is a column rather than a note.
  registrationType RegistrationType @default(REGULAR)

  /// SNAPSHOT — which attempt at this course this is, starting at 1.
  ///
  /// Server-assigned, never accepted from a client. Numbered per
  /// (student, course) across the whole degree rather than per semester,
  /// because a backlog cleared two years later is the second attempt at the
  /// same course, not the first attempt at a new one.
  attemptNumber Int @default(1)

  status RegistrationStatus @default(REGISTERED)

  /// When the status last changed.
  ///
  /// ONE column rather than a nullable timestamp per state. Five sparse
  /// timestamps would be the same unlinked state/time pattern recorded as TD-E,
  /// and the full transition history — every state, with its actor and reason —
  /// is already reconstructable from AuditLog, which records before and after
  /// on every mutation.
  statusChangedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Every reference uses NoAction, checked by PostgreSQL at end-of-statement.
  /// It refuses a standalone delete that would orphan a registration — an
  /// academic record must not be silently detachable — while still allowing a
  /// cascading delete that removes a whole tenant in one statement.
  student   Student    @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course    Course     @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  semester  Semester   @relation(fields: [semesterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// SetNull rather than NoAction: a teaching group may be retired without
  /// invalidating the enrolment, because (courseId, semesterId) is the roster.
  section   Section?   @relation(fields: [sectionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  programme Programme? @relation(fields: [programmeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// Composite key, so a registration can only ever cite a regulation of its
  /// own tenant — proven by the database rather than by application discipline.
  /// The other four references use single-column keys because Student, Course,
  /// Semester and Section are live, migrated tables and adding
  /// @@unique([tenantId, id]) to each would mean a blocking index build on
  /// populated data for a guarantee the single write path already provides.
  evaluationScheme       EvaluationScheme        @relation(fields: [tenantId, evaluationSchemeId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  studentComponentScores StudentComponentScore[]

  /// One row per attempt at a course.
  ///
  /// tenantId is deliberately absent: a Student belongs to exactly one tenant,
  /// so this is already tenant-safe, and the narrower index is the better one.
  /// It also serves the attempt-history read — every attempt a student has made
  /// at one course — which is what backlog and improvement policy consult.
  ///
  /// What it cannot express is "no two CONCURRENT active attempts", a cross-row
  /// predicate no unique index can hold; the service enforces that, and it is
  /// the single check covering both duplicate registration and duplicate
  /// attempt.
  openElectiveAllocations OpenElectiveAllocation[]

  @@unique([studentId, courseId, attemptNumber])
  /// Composite-FK target for the marks and result tables that will cite a
  /// registration. Declared now because adding a unique index to a
  /// million-row table later is the expensive kind of migration.
  @@unique([tenantId, id])
  /// THE roster query — "who is enrolled in this course this term". The hot
  /// path for every marks-entry and result-computation run. A section-narrowed
  /// roster rides the same index and filters a set bounded by class size.
  ///
  /// No [tenantId, studentId, semesterId] index is declared: the unique above
  /// leads with studentId, and a student accumulates a few dozen registrations
  /// in a whole degree, so filtering that set costs nothing an index would save.
  @@index([tenantId, semesterId, courseId])
}

/// Phase 16 — Component 6.1.
///
/// One SITTING of one evaluation component: the ST1 held for CS101 section A in
/// March, the end-semester theory paper, the viva, the practical.
///
/// WHY THIS IS NOT THE SAME THING AS A COMPONENT
///   EvaluationComponent says an assessment EXISTS and how it aggregates — "ST1
///   is worth 10, best 2 of 3 sittings count". This says a sitting HAPPENED:
///   when, for which teaching group, out of what total, conducted by whom. A
///   component with a BEST_N aggregation is meaningless without several of
///   these, which is what `sequenceNumber` counts.
///
/// WHY IT IS NOT AN Examination
///   The Phase 10 Examination model is a scheduling record and stays exactly as
///   it is. This is the evaluation-plane equivalent, and it exists because most
///   of what a regulation assesses is not an examination at all — an assignment,
///   an attendance derivation and a faculty evaluation are all components with
///   sittings, and none of them fits a model built around a venue and a
///   duration.
///
/// OWNERSHIP    : Tenant, through the component whose sitting it is. The
///                component pins the scheme, so the governing regulation is
///                reachable from any mark without the event restating it.
/// LIFECYCLE    : DRAFT -> OPEN -> LOCKED -> PUBLISHED, with LOCKED -> OPEN and
///                PUBLISHED -> LOCKED as the correction paths. Marks may be
///                entered only while OPEN; that single rule is what locking
///                means.
/// SOURCE OF    : When a sitting happened, what it was marked out of, and
/// TRUTH          whether its marks are open, frozen or visible. It owns no
///                marks and no results.
model AssessmentEvent {
  id String @id @default(cuid())

  tenantId String

  /// What is being assessed. Pins the component, and through it the immutable
  /// scheme revision — so a mark recorded here is always explicable under the
  /// regulation in force when it was taken.
  evaluationComponentId String

  /// The course and term this sitting belongs to.
  ///
  /// Both are required and NEITHER is derivable from the component: a component
  /// belongs to a regulation, not to a course, and one regulation governs many
  /// courses. Together they are also the key that resolves the roster from
  /// CourseRegistration.
  courseId   String
  semesterId String

  /// The teaching group, or NULL when the sitting covers every registration for
  /// this course and term.
  ///
  /// A meaningful null: a university-conducted theory paper is sat by the whole
  /// cohort at once, while an internal test is usually per section.
  sectionId String?

  /// Human label — "ST1 — March 2026". What distinguishes two sittings to a
  /// person; `sequenceNumber` is what distinguishes them to the engine.
  title String

  /// What THIS PAPER was marked out of.
  ///
  /// Deliberately distinct from EvaluationComponent.maxMarks, and not a
  /// duplicate of it. The component's figure is the scale the component
  /// CONTRIBUTES on; this is the total the paper was actually set out of. A test
  /// conducted out of 25 and contributing on a scale of 20 is an ordinary
  /// arrangement, and the gap between them is closed by a SCALE rule rather than
  /// by pretending the two numbers are one. Defaulted from the component when
  /// the caller does not say otherwise.
  maxMarks Decimal @db.Decimal(6, 2)

  /// Which sitting of this component this is, starting at 1.
  ///
  /// Server-assigned, never accepted from a client. This is what makes BEST_N
  /// and DROP_LOWEST_N meaningful: "best 2 of 3" is a statement about three rows
  /// here, and a client able to choose the numbering could hide a sitting from
  /// the aggregation.
  sequenceNumber Int @default(1)

  /// When the sitting was held. Nullable because an event is often created
  /// before its date is fixed.
  scheduledAt DateTime?

  /// The faculty member who conducted it.
  ///
  /// Nullable, and carried rather than derived: FacultyCourseAssignment is
  /// mutable and carries the duplicate-row defect recorded as TD-001, so it
  /// cannot answer "who ran this sitting" after the fact. Faculty analytics
  /// needs a stable attribution.
  conductedById String?

  status AssessmentEventStatus @default(DRAFT)

  /// When the status last changed. ONE column rather than a nullable timestamp
  /// per state: four sparse timestamps would be the unlinked state/time pattern
  /// recorded as TD-E, and AuditLog already holds every transition with its
  /// actor. While the status is PUBLISHED this is the publication date a
  /// student is shown.
  statusChangedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Composite key, so a sitting can only ever assess a component of its own
  /// tenant — proven by the database rather than by application discipline.
  evaluationComponent EvaluationComponent @relation(fields: [tenantId, evaluationComponentId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  /// Single-column keys for the pre-Phase-16 tables, which have no
  /// @@unique([tenantId, id]); adding one to each would mean a blocking index
  /// build on live data for a guarantee the single write path already provides.
  /// NoAction throughout, checked at end-of-statement: it refuses a standalone
  /// delete that would orphan a sitting while still permitting a tenant cascade.
  course                 Course                  @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  semester               Semester                @relation(fields: [semesterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  section                Section?                @relation(fields: [sectionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  conductedBy            FacultyMember?          @relation(fields: [conductedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  studentComponentScores StudentComponentScore[]

  /// One sitting per position, per component, per course, per term, per group.
  ///
  /// NOTE — sectionId is nullable and PostgreSQL treats NULL as distinct, so
  /// this constrains section-scoped sittings completely but leaves
  /// cohort-wide ones able to share a position. Known and compensated, as in C3
  /// and C4: the service checks it, and list order ends on `id`, so the ordering
  /// is total regardless.
  @@unique([evaluationComponentId, courseId, semesterId, sectionId, sequenceNumber])
  /// Composite-FK target for the marks table, which must cite a sitting.
  @@unique([tenantId, id])
  /// THE hot query — every sitting for a course in a term. The marks-entry
  /// landing page, and the calculation engine's input set.
  @@index([tenantId, semesterId, courseId])
}

/// Phase 16 — Component 6.2.
///
/// ONE STUDENT'S MARK AT ONE SITTING. The only marks table in the system.
///
/// THE PATH IS THE POINT
///   CourseRegistration -> AssessmentEvent -> StudentComponentScore.
///
///   A mark cites an ENROLMENT, never a student. That single choice is what
///   makes attempt tracking, backlogs, improvement, revaluation and a
///   reproducible SGPA possible: the registration carries the attempt number,
///   the credits and the immutable regulation the mark is graded under. A mark
///   keyed on a student id would lose all four the moment that student advanced
///   a semester.
///
/// WHAT IS DELIBERATELY NOT A COLUMN HERE
///   Grace, moderation, improvement and revaluation are all supported, and none
///   of them is a field on this row:
///
///     Grace       — an EvaluationRule (C4) GRACE operation, applied at
///                   computation. Storing granted marks would bake a policy
///                   into data and make it irreproducible if the policy changed.
///     Moderation  — either an EvaluationRule MODERATION operation for a cohort
///                   shift, or an ordinary amendment to this row for one
///                   student, whose before and after AuditLog records.
///     Improvement — a new CourseRegistration (C5.5) of type IMPROVEMENT, and
///                   therefore a new attempt with its own marks.
///     Revaluation — an amendment to THIS row. The attempt does not change, so
///                   no new registration and no new mark: the value moves and
///                   the audit trail holds what it was.
///
///   Adding columns for any of them would give one fact two homes.
///
/// SCALE
///   This is the largest table in the phase — students × courses × components ×
///   sittings. tenantId is carried rather than reached through the registration
///   precisely because every query here must be tenant-scoped without a join,
///   and because partitioning by tenant later needs it present. The composite
///   foreign keys prove it agrees with both parents.
model StudentComponentScore {
  id String @id @default(cuid())

  /// Denormalised for the reason above. Constrained by BOTH composite foreign
  /// keys below to equal the parents' tenantId, so it cannot drift.
  tenantId String

  assessmentEventId    String
  courseRegistrationId String

  /// The mark, on the sitting's own scale.
  ///
  /// NULL if and only if the student was ABSENT — someone who did not sit has
  /// no mark, which is different from a mark of zero and grades differently
  /// under a mandatory component. Decimal(6,2) matches the maxMarks columns it
  /// is bounded by, so a mark can never overflow the scale it was set against.
  marksObtained Decimal? @db.Decimal(6, 2)

  status MarkStatus @default(RECORDED)

  /// Why, when the mark alone does not say — "absent, medical certificate
  /// produced", "revalued on appeal". Free text, because the reasons a
  /// university records are its own.
  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Both parents are cited by COMPOSITE key, so a mark can only ever join a
  /// sitting and an enrolment belonging to the same tenant — proven by the
  /// database rather than by application discipline.
  ///
  /// NoAction on both: a mark must never be silently orphaned, and PostgreSQL
  /// checks NO ACTION at end-of-statement, so a tenant-level cascade still
  /// succeeds while a stray single-row delete is refused.
  assessmentEvent    AssessmentEvent    @relation(fields: [tenantId, assessmentEventId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  courseRegistration CourseRegistration @relation(fields: [tenantId, courseRegistrationId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  /// One mark per student per sitting — "no duplicate marks", enforced rather
  /// than checked.
  ///
  /// Both columns are NOT NULL, so PostgreSQL enforces this COMPLETELY, unlike
  /// the nullable-column constraints recorded as TD-001 and TD-003 where
  /// NULL-distinctness leaves duplicates storable.
  ///
  /// Leading with assessmentEventId also makes this the index for the marks
  /// sheet — every mark at one sitting — which is why no separate index on that
  /// column is declared.
  @@unique([assessmentEventId, courseRegistrationId])
  /// Every mark for one enrolment: the result engine's input set, and the query
  /// that turns a student's whole academic record into one index scan.
  @@index([tenantId, courseRegistrationId])
}

model FeeStructure {
  id             String         @id @default(cuid())
  tenantId       String
  programmeId    String?
  batchId        String?
  academicYearId String?
  name           String
  description    String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  components     FeeComponent[]
  demands        FeeDemand[]

  @@index([tenantId])
}

model FeeComponent {
  id             String       @id @default(cuid())
  feeStructureId String
  name           String
  type           FeeType      @default(TUITION)
  amount         Decimal      @db.Decimal(10, 2)
  isOptional     Boolean      @default(false)
  isTaxable      Boolean      @default(false)
  taxPercent     Decimal?     @db.Decimal(5, 2)
  createdAt      DateTime     @default(now())
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@index([feeStructureId])
}

model FeeDemand {
  id             String        @id @default(cuid())
  tenantId       String
  studentId      String
  semesterId     String?
  feeStructureId String?
  dueDate        DateTime
  totalAmount    Decimal       @db.Decimal(10, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(10, 2)
  waivedAmount   Decimal       @default(0) @db.Decimal(10, 2)
  status         FeeStatus     @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id])
  semester       Semester?     @relation(fields: [semesterId], references: [id])
  student        Student       @relation(fields: [studentId], references: [id])
  payments       Payment[]

  @@index([tenantId])
  @@index([studentId])
}

model Payment {
  id            String        @id @default(cuid())
  tenantId      String
  studentId     String
  feeDemandId   String?
  receiptNo     String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod @default(ONLINE)
  status        PaymentStatus @default(PENDING)
  transactionId String?
  gatewayRef    String?
  gatewayMeta   Json?
  paidAt        DateTime?
  remarks       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  feeDemand     FeeDemand?    @relation(fields: [feeDemandId], references: [id])
  student       Student       @relation(fields: [studentId], references: [id])

  @@index([tenantId])
  @@index([studentId])
}

model CertificateTemplate {
  id           String          @id @default(cuid())
  tenantId     String
  name         String
  type         CertificateType @default(CUSTOM)
  htmlTemplate String
  cssStyles    String?
  variables    Json?
  isActive     Boolean         @default(true)

  /// Version number within one template's lineage, starting at 1.
  ///
  /// Editing a template that has already ISSUED something does not change it —
  /// a new row is written with version + 1, because a certificate handed to a
  /// graduate must keep the design it was issued under.
  version Int @default(1)

  /// The first row of this lineage. Null on that first row itself.
  ///
  /// Lineage rather than a self-referential chain so "every version of this
  /// template" is one indexed query instead of a walk.
  parentTemplateId String?

  /// When this version became issuable. Null while it is a draft.
  publishedAt DateTime?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  certificates Certificate[]
  tenant       Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([parentTemplateId])
}

model Certificate {
  id            String          @id @default(cuid())
  tenantId      String
  templateId    String
  studentId     String
  certificateNo String          @unique
  type          CertificateType
  data          Json?

  /// The template EXACTLY as it was when this certificate was issued —
  /// { version, html, css }.
  ///
  /// The point of an official document is that it does not change. Rendering
  /// from templateId would mean a design edit in 2027 silently rewrote a
  /// certificate issued in 2026, so the markup travels with the certificate
  /// instead. Nullable: rows issued before this column existed keep rendering
  /// from their template, which is the best that can be said of them.
  ///
  /// NOT exposed by the public verification endpoint — see its own SELECT.
  templateSnapshot Json?

  issuedAt  DateTime            @default(now())
  expiresAt DateTime?
  pdfUrl    String?
  qrCode    String?
  isRevoked Boolean             @default(false)
  revokedAt DateTime?
  revokedBy String?
  createdAt DateTime            @default(now())
  student   Student             @relation(fields: [studentId], references: [id])
  template  CertificateTemplate @relation(fields: [templateId], references: [id])

  @@index([tenantId])
  @@index([studentId])
  @@index([certificateNo])
}

model NotificationTemplate {
  id            String           @id @default(cuid())
  tenantId      String?
  name          String
  type          NotificationType
  subject       String?
  body          String
  variables     Json?
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  notifications Notification[]

  @@index([tenantId])
}

/// Phase 13 model, extended by Phase 27 with the four things a Notification
/// Center needs and Phase 13 had no reason to store.
///
/// EVERY ADDITION IS NULLABLE AND ADDITIVE. No Phase 13 column changes type,
/// nullability or default, and `POST /api/notifications/send` continues to
/// write exactly the columns it wrote before. An existing row simply has NULL
/// in the new columns, which reads as "uncategorised, not archived, not
/// deleted" — the correct interpretation of a row written before the concept
/// existed.
model Notification {
  id         String           @id @default(cuid())
  tenantId   String
  templateId String?
  userId     String?
  type       NotificationType
  subject    String?
  body       String
  data       Json?
  sentAt     DateTime?
  readAt     DateTime?
  status     String           @default("PENDING")
  error      String?
  createdAt  DateTime         @default(now())

  /// Phase 27 — WHAT the notification is about.
  ///
  /// A SECOND AXIS, NOT A REPLACEMENT FOR `type`. The pre-existing
  /// NotificationType is a DELIVERY CHANNEL (EMAIL · SMS · PUSH · IN_APP);
  /// the README's "Notification Categories" list (Academic, Attendance,
  /// Assignments, Results, Fees, ...) is subject matter. The two are
  /// independent — an EMAIL about attendance and an IN_APP about attendance
  /// share a category and differ in channel — so overloading `type` would have
  /// made "all my fee notifications" unanswerable without also constraining
  /// how they were delivered.
  ///
  /// Nullable because every row Phase 13 has already written predates the
  /// concept and no category can be inferred for it.
  category NotificationCategory?

  /// Phase 27 — "Archive Notification". Set once; the row leaves the default
  /// list and remains readable under ?archived=true.
  archivedAt DateTime?

  /// Phase 27 — "Delete Notification", as a SOFT delete.
  ///
  /// A notification is a record that something was communicated to someone. A
  /// recipient dismissing it from their bell is a display preference, not
  /// grounds to destroy the institution's evidence that the message was sent —
  /// the same reasoning that makes Certificate revocation a flag rather than a
  /// DELETE. Every read path filters on this being NULL.
  deletedAt DateTime?

  template NotificationTemplate? @relation(fields: [templateId], references: [id])
  tenant   Tenant                @relation(fields: [tenantId], references: [id])

  /// Phase 27 — the foreign key this column never had.
  ///
  /// `userId` was a bare unconstrained string (the TD-C / TD-C41 family). The
  /// Notification Center reads exclusively by recipient, so an id pointing at
  /// no one is a row no user can ever see and no query can ever explain.
  /// SetNull rather than Cascade: DELETE /api/users/[id] is a hard delete, and
  /// a tenant-wide broadcast row must survive one recipient being removed.
  ///
  /// The migration nulls any already-dangling value before adding the
  /// constraint — see the migration file for why that is the only safe order.
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([tenantId])
  @@index([userId])
  /// The Notification Center's one hot read: this user's live notifications,
  /// newest first. Composite because it is a NEW index on an existing table and
  /// serves the query the bell makes on every page load.
  @@index([userId, deletedAt, archivedAt, createdAt])
}

model AuditLog {
  id         String  @id @default(cuid())
  tenantId   String
  userId     String?
  action     String
  resource   String
  resourceId String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?

  /// PRD 47 "Failed action logs".
  ///
  /// Without this column a refused action is indistinguishable from one that
  /// never happened, and a rejected privilege escalation leaves no trace at
  /// all — which is precisely the event an investigator is looking for. A
  /// FAILURE row is written OUTSIDE the transaction that failed, because
  /// anything written inside it rolls back with it.
  status AuditStatus @default(SUCCESS)

  /// Ties every entry produced by one request together.
  ///
  /// A single admission writes an identifier issue, a user creation and a
  /// student creation. Without a shared handle an investigator reconstructing
  /// that from timestamps alone has to guess which rows belong together, and
  /// guesses wrong the moment two clerks work at once.
  correlationId String?

  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
  /// The viewer's default read: one tenant, newest first.
  @@index([tenantId, createdAt])
  @@index([correlationId])
}

/// PRD 47 — whether the audited action succeeded.
enum AuditStatus {
  SUCCESS
  FAILURE
}

/// ============================================================================
/// PLATFORM IDENTITY (W1.2)
///
/// The EduOS platform's own operators. Deliberately SEPARATE from User/Role/
/// UserRole, which are tenant-owned.
///
/// WHY A SECOND SET OF TABLES RATHER THAN A FLAG ON User
///   Before W1.2, platform authority was a tenant Role named "SUPER_ADMIN".
///   Role is @@unique([tenantId, name]) — a per-tenant row — and requireRole
///   compared role NAMES taken from the JWT. So a university admin could grant
///   themselves that role through the ordinary role-assignment API and read
///   every tenant on the platform. Reproduced live in the W1.1 audit.
///
///   The vulnerability existed because platform authority was expressed as a
///   value inside data that tenants are allowed to write. No amount of
///   validation on that value fixes it: deny-listing the name leaves the next
///   tenant free to mint its own, and an isSystem flag is still a tenant-owned
///   column.
///
///   These tables carry NO tenantId. There is no column a tenant can write that
///   grants membership, so the escalation is not blocked — it is unrepresentable.
/// ============================================================================
model PlatformUser {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  firstName    String
  lastName     String
  isActive     Boolean @default(true)

  /// W1.3 — the account holds a password it did not choose.
  ///
  /// Set when an operator is created by another operator, and when their
  /// password is reset for them: in both cases a second person has seen the
  /// plaintext, so it is a shared secret until the owner replaces it. While
  /// this is true the account can sign in and do exactly one thing — change its
  /// password. requirePlatformAdmin refuses everything else, so the flag is an
  /// actual gate rather than a hint the UI may choose to honour.
  ///
  /// Defaults to false so every pre-W1.3 row keeps working unchanged.
  mustChangePassword Boolean @default(false)

  lastLoginAt DateTime?

  /// Console accent chosen by THIS operator, for THIS operator.
  ///
  /// Null means the product default, which is also the fallback for any value
  /// the application no longer recognises — a preference must never be able to
  /// break the console that renders it.
  ///
  /// A plain nullable column rather than a UserPreference table: exactly one
  /// preference exists, it belongs to exactly one row, and a generic key/value
  /// store would be a second settings system for a single string.
  ///
  /// Scoped by construction — it is read only by the platform console layout
  /// and applied to that subtree alone, so it can never reach a tenant portal.
  accentColor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  platformUserRoles PlatformUserRole[]

  /// PRD §5.1 "Assign support manager". Back-relation only — emits no column on
  /// PlatformUser; the FK lives on Tenant.
  supportedTenants Tenant[] @relation("TenantSupportManager")

  /// PRD §7 — platform-owned page templates this operator last edited.
  cmsTemplates CmsTemplate[] @relation("CmsTemplateEditor")

  @@index([email])
}

/// A platform-level role. W1.2 defines exactly one: PLATFORM_ADMIN.
///
/// PRD §4.1 lists ~13 platform roles, but defines no permissions for any of
/// them. Seeding twelve roles that grant nothing and gate nothing would be
/// inventing an authorization model the PRD does not describe, so they are
/// recorded as deferred until their semantics exist.
model PlatformRole {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  platformUserRoles PlatformUserRole[]
}

/// Membership. Composite primary key, so a role cannot be granted twice.
model PlatformUserRole {
  platformUserId String
  platformRoleId String
  grantedAt      DateTime @default(now())

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  platformRole PlatformRole @relation(fields: [platformRoleId], references: [id], onDelete: Cascade)

  @@id([platformUserId, platformRoleId])
  @@index([platformUserId])
}

model IdSequence {
  id         String @id @default(cuid())
  tenantId   String
  entityType String

  /// PRD 9.3 "Reset sequence by campus" and "by programme".
  ///
  /// The counter dimension BELOW tenant + entityType. Empty string means the
  /// tenant keeps one counter for this entity; a campus or programme id means
  /// one counter per campus or per programme, which is what lets
  /// EMP-JPR-ADM-00125 and EMP-DEL-ADM-00125 both be 125 within their own
  /// campus.
  ///
  /// Empty rather than null because a null would make the unique index below
  /// stop constraining anything: Postgres treats every NULL as distinct, so two
  /// unscoped sequences for the same entity could be created and each would
  /// hand out the same numbers.
  scopeKey String @default("")

  prefix         String?
  suffix         String?
  format         String        @default("{PREFIX}{YEAR}{SEQ}")
  padding        Int           @default(4)
  lastSequence   Int           @default(0)
  resetCycle     SequenceReset @default(YEARLY)
  lastResetYear  Int?
  lastResetMonth Int?

  /// A retired sequence stops issuing without being deleted.
  ///
  /// Deleting one would lose lastSequence, and a sequence recreated at zero
  /// would reissue numbers already printed on certificates and ID cards. The
  /// generator refuses an inactive row rather than falling back to a default,
  /// so switching this off is a deliberate, visible stop.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// The counter identity. This index is what makes concurrent generation safe:
  /// the single UPDATE ... RETURNING that issues a number locks exactly one row,
  /// so two simultaneous requests serialise on it rather than both reading the
  /// same lastSequence.
  @@unique([tenantId, entityType, scopeKey])
  @@index([tenantId])
}

