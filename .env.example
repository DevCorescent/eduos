# ============================================================================
# eduOS — Environment Variables (template)
#
# Copy to .env and fill in real values. NEVER commit real secrets.
# ============================================================================

# ── Database (Neon PostgreSQL) ──────────────────────────────────────────────
DATABASE_URL=""

# ── App ─────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
APP_NAME="eduOS"
# Tenants are resolved from the Host header as <slug>.<root domain>.
# Server-only — do NOT add NEXT_PUBLIC_ prefix.
ROOT_DOMAIN="localhost:3000"

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ── File Storage (Cloudflare R2) ────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# ── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ── AI (Groq) ───────────────────────────────────────────────────────────────
GROQ_API_KEY=""

# ── Misc ────────────────────────────────────────────────────────────────────
NODE_ENV="development"
